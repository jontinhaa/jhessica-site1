# Cloudflare Pages: cabeçalhos de segurança (arquivo _headers, copiado para dist/ no build).
# A CSP não restringe script-src nem style-src de propósito: o Astro e o site usam scripts e estilos inline e o JSON-LD.
# Se um dia isso for restringido, teste home, /pedido e /p/{produto} antes de publicar.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me https://api.whatsapp.com

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
