---
import { Font } from 'astro:assets';
import { seo } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = seo.titulo, description = seo.descricao } = Astro.props;
---

<!doctype html>
<html lang={seo.idioma} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Tema antes do primeiro paint: escolha salva > preferência do sistema -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-poster" />
    <Font cssVariable="--font-hand" />
  </head>
  <body>
    <div class="page-bg" aria-hidden="true"><div class="grain"></div><i class="glow g1"></i><i class="glow g2"></i></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
