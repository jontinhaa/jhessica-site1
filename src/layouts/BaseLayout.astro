---
import { Font, getImage } from 'astro:assets';
import ogPadrao from '../assets/images/og-padrao.jpg';
import { marca, seo } from '../data/site';
import { descricaoSite } from '../data/promessa';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PedidoFlutuante from '../components/ui/PedidoFlutuante.astro';
import Carregando from '../components/layout/Carregando.astro';
import { url } from '../lib/url';
import { urlAbsoluta } from '../lib/absoluta';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Prévia do link (WhatsApp, redes): imagem já com endereço absoluto. Sem ela, vale a padrão (og-padrao.jpg, 1200×630). */
  image?: string;
  imageAlt?: string;
  /** Tamanho real da imagem de prévia (og:image:width/height). */
  imageLargura?: number;
  imageAltura?: number;
  /** Endereço canônico absoluto (páginas de prévia apontam para o produto no /pedido). */
  canonical?: string;
  /** Leva quem abre a página para outro endereço (páginas de compartilhamento /p/{id}); o robô do WhatsApp lê o HTML antes. */
  redirect?: string;
  /** Fora do Google (páginas só de prévia, 404). */
  noindex?: boolean;
  /** Dados estruturados (JSON-LD) desta página; a home manda o da confeitaria (src/lib/seo.ts). */
  jsonLd?: object;
  /** Tela de carregamento "o forno preaquecendo" (só a home), uma vez por sessão. */
  carregando?: boolean;
}
const { title = seo.titulo, description = descricaoSite(), imageAlt, canonical, redirect, noindex, jsonLd, carregando } = Astro.props;

// prévia padrão: jpeg 1200×630 (o WhatsApp ignora imagem pesada ou em webp em alguns aparelhos)
const padrao = Astro.props.image ? undefined : await getImage({ src: ogPadrao, width: 1200, height: 630, format: 'jpeg', quality: 82 });
const image = Astro.props.image ?? urlAbsoluta(padrao!.src, Astro.site);
const imageLargura = Astro.props.image ? Astro.props.imageLargura : 1200;
const imageAltura = Astro.props.image ? Astro.props.imageAltura : 630;
const imageAltFinal = imageAlt ?? (Astro.props.image ? undefined : `Bolo de chocolate coberto de calda em forma de alumínio, ${marca.nome}`);
const fora = noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
// canonical: o informado (páginas de prévia apontam para o /pedido) ou o próprio endereço, sem query, nas páginas indexáveis
const canonicalFinal = canonical ?? (noindex ? undefined : new URL(Astro.url.pathname, Astro.site ?? Astro.url).href);
// JSON-LD dentro de <script>: "<" escapado para nenhum texto fechar a tag
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={seo.idioma} data-theme="dark" data-forno={carregando ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={marca.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={image} />
    {imageLargura && <meta property="og:image:width" content={String(imageLargura)} />}
    {imageAltura && <meta property="og:image:height" content={String(imageAltura)} />}
    {imageAltFinal && <meta property="og:image:alt" content={imageAltFinal} />}
    <meta name="twitter:card" content="summary_large_image" />
    {canonicalFinal && <link rel="canonical" href={canonicalFinal} />}
    {redirect && <meta http-equiv="refresh" content={`0; url=${redirect}`} />}
    {redirect && <script is:inline define:vars={{ redirect }}>location.replace(redirect);</script>}
    <meta name="color-scheme" content="light dark" />
    <!-- barra do navegador: começa pelo tema do sistema; o script abaixo acompanha o tema escolhido no site -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={seo.corTema.dia} data-dia={seo.corTema.dia} data-noite={seo.corTema.noite} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={seo.corTema.noite} data-dia={seo.corTema.dia} data-noite={seo.corTema.noite} />
    {fora && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <meta name="generator" content={Astro.generator} />
    <!-- Tema antes do primeiro paint: escolha salva > preferência do sistema.
         Reaplicado quando a página volta do cache de voltar/avançar (o script não roda de novo) e quando outra aba troca o tema.
         A cor da barra do navegador (theme-color) segue o data-theme, inclusive quando a chave do site troca o tema. -->
    <script is:inline>
      (function () {
        var raiz = document.documentElement;
        function pintarBarra() {
          var dia = raiz.getAttribute('data-theme') === 'light';
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.setAttribute('content', dia ? m.dataset.dia : m.dataset.noite); });
        }
        new MutationObserver(pintarBarra).observe(raiz, { attributes: true, attributeFilter: ['data-theme'] });
        // tela de carregamento (Carregando.astro): só onde a página pediu e uma vez por sessão; decidido antes do 1º quadro
        if (raiz.hasAttribute('data-forno')) {
          var visto = false;
          try { visto = sessionStorage.getItem('jhessica:forno') === '1'; } catch (e) {}
          if (!visto) {
            raiz.classList.add('carregando');
            // trava independente: se o script da tela não rodar ou parar no meio (rede, bloqueador, erro, navegador antigo),
            // a página libera sozinha em 8 s: some a tela e o resto deixa de ser inerte (o script o marca ao começar)
            setTimeout(function () {
              if (!raiz.classList.contains('carregando')) return;
              raiz.classList.remove('carregando');
              Array.prototype.forEach.call(document.body.children, function (e) { e.removeAttribute('inert'); });
            }, 8000);
          }
        }
        function aplicar() {
          var t = null;
          try { t = localStorage.getItem('theme'); } catch (e) {}
          if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', t);
        }
        aplicar();
        addEventListener('pageshow', function (e) { if (e.persisted) aplicar(); });
        addEventListener('storage', function (e) { if (e.key === 'theme') aplicar(); });
        document.documentElement.classList.add('rv-on');
      })();
    </script>
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-poster" />
    <Font cssVariable="--font-hand" />
  </head>
  <body>
    {carregando && <Carregando />}
    <div class="page-bg" aria-hidden="true"><div class="grain"></div><i class="glow g1"></i><i class="glow g2"></i></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    {!Astro.url.pathname.startsWith(url('/pedido')) && <PedidoFlutuante />}
    <script>
      // [data-rv]: revela ao entrar na tela (88%; 94% com movimento reduzido), em cascata de 80ms entre vizinhos
      const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }), { rootMargin: `0px 0px ${reduzido ? -6 : -12}% 0px` });
      document.querySelectorAll<HTMLElement>('[data-rv]').forEach((el) => {
        if (!reduzido) el.style.setProperty('--rv-d', `${([...el.parentElement!.children].indexOf(el) % 4) * 80}ms`);
        io.observe(el);
      });

      // .tag--onda ("Mais pedido"): a faixa dourada só corre na tela, como os rabiscos (no <dialog> fechado, fica parada)
      if (!reduzido) {
        const onda = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('longe', !e.isIntersecting)));
        document.querySelectorAll('.tag--onda').forEach((t) => onda.observe(t));
      }

      // âncoras na mesma página: com content-visibility (global.css), as seções ainda não vistas têm altura estimada;
      // depois do salto elas renderizam e empurram o alvo. Reposiciona até ele parar (no máximo 6 quadros).
      addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href*="#"]');
        if (!a || a.pathname !== location.pathname || a.hash.length < 2) return;
        const alvo = document.getElementById(decodeURIComponent(a.hash.slice(1)));
        if (!alvo) return;
        let n = 0;
        const ajustar = () => {
          if (Math.abs(alvo.getBoundingClientRect().top - parseFloat(getComputedStyle(alvo).scrollMarginTop)) > 1) alvo.scrollIntoView();
          if (++n < 6) requestAnimationFrame(ajustar);
        };
        requestAnimationFrame(ajustar);
      });
    </script>
  </body>
</html>
