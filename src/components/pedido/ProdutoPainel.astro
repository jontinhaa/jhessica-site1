---
// Painel "Detalhes" de um produto, em <dialog> nativo. Um por produto, renderizado no build.
// Celular (< 860px): folha que sobe de baixo (arrasta para fechar). Desktop: painel lateral à direita.
// Abre por [data-abrir="{id}"] ou por ?produto={id} na URL; o histórico do navegador abre e fecha (pushState/popstate).
// Escolhas (variante, adicionais, opções, sem ovos, caixa de brigadeiros, quantidade) recalculam preço, prazo e o
// aviso do que falta; "Adicionar à sacola" usa a sacola provisória (src/scripts/sacola.ts).
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { acrescimosVisiveis, aveiaContaComoGluten, formatarPreco, getImagensProduto, ingredientesVisiveis, levaAveia, ondeNaOpcao, opcoesComAveia, podeConterSemRepetir, type Produto } from '../../data/cardapio';
import { dadosCompartilhar } from '../../lib/pedido/compartilhar';
import { conservacao, prazoDias, redes, regrasPedido, rotulosAlergenos } from '../../data/site';

interface Props { produto: Produto }
const { produto: p } = Astro.props;

const { capa, corte, extras } = getImagensProduto(p.id);
const fotos = [capa, corte, ...extras].filter((f) => f !== undefined);
const caixa = p.montarCaixa ? p.opcoes?.find((o) => o.id === 'sabor') : undefined;
const opcoes = (p.opcoes ?? []).filter((o) => o !== caixa);
const v0 = p.variantes[0];
const semOvo = !p.alergenos.contem.includes('ovo');
const tituloId = `t-painel-${p.id}`;
const dados = Object.fromEntries(Object.entries(dadosCompartilhar(p, Astro.site ?? Astro.url.origin, import.meta.env.BASE_URL)).map(([k, v]) => [`data-${k}`, v]));

// alérgenos: os do produto + os que vêm com um sabor/massa ("Amendoim (paçoca)", "Glúten (aveia comum, massa de chocolate)")
const rotulos = (lista: string[]) => lista.map((a) => rotulosAlergenos[a as keyof typeof rotulosAlergenos]);
const comOnde = (rotulo: string, onde: string) => (rotulo.endsWith(')') ? `${rotulo.slice(0, -1)}, ${onde})` : `${rotulo} (${onde})`);
const dasOpcoes = (p.opcoes ?? []).flatMap((o) => o.valores.flatMap((v) => (v.contem ?? []).map((a) => comOnde(rotulosAlergenos[a], ondeNaOpcao(p, o, v.nome)))));
// aveia comum: aviso para celíacos no produto inteiro ou em cada opção que a leva (massa de chocolate do Bento)
const aveia = levaAveia(p);
const avisosAveia = aveia === true
  ? ['Leva aveia comum: não indicado para celíacos.']
  : opcoesComAveia(p).map(({ opcao, valor }) => `Com ${ondeNaOpcao(p, opcao, valor)}, leva aveia comum: não indicado para celíacos.`);
const ingredientes = ingredientesVisiveis(p);
// a lista do produto é a base; cada sabor, massa, recheio ou parte fixa (fatias, coberturas do Bento) ganha uma linha
const acrescimos = acrescimosVisiveis(p);
const contem = [...rotulos(p.alergenos.contem), ...dasOpcoes];
const contemSemOvo = [...rotulos(p.alergenos.contem.filter((a) => a !== 'ovo')), ...dasOpcoes];
const conserva = conservacao.porCategoria[p.categoria];
const prazo = prazoDias(p.categoria, v0.unidades);
const brigadeiros = p.categoria === 'brigadeiros';
---

<dialog
  class="painel folha" id={`painel-${p.id}`} aria-labelledby={tituloId}
  data-produto={p.id} data-nome={p.nome}
  data-prazo-min={regrasPedido.prazoMinimoDias} data-prazo-esp={regrasPedido.prazoEspecialDias}
  data-limite={brigadeiros ? regrasPedido.limiteBrigadeirosUnidades : undefined}
>
  <div class="folha-in">
    <div class="alca" aria-hidden="true"><i></i></div>
    <button class="folha-fechar" type="button" aria-label="Fechar detalhes" data-fechar><Icon name="solar:close-linear" /></button>

    <form class="folha-corpo" novalidate>
      {fotos.length ? (
        <div class="galeria-bloco">
          <div class="galeria" role="region" aria-roledescription="carrossel" aria-label={`Fotos de ${p.nome}`}>
            {fotos.map((f, i) => (
              <div class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} de ${fotos.length}`}>
                <Image src={f} alt={i === 0 ? p.nome : ''} widths={[480, 960]} sizes="(max-width: 859px) 100vw, 480px" loading="lazy" />
              </div>
            ))}
          </div>
          {fotos.length > 1 && (
            <div class="dots-nav">
              {fotos.map((_, i) => <button type="button" class:list={[i === 0 && 'is-on']} aria-label={`Foto ${i + 1}`}></button>)}
            </div>
          )}
        </div>
      ) : (
        <div class="galeria ph ph-empty" data-ph={`produtos/${p.id}/capa`}></div>
      )}

      <header class="cabeca">
        {(p.maisPedido || semOvo || aveia) && (
          <div class="tags">
            {p.maisPedido && <span class="tag tag--caramelo tag--onda">Mais pedido</span>}
            {semOvo && <span class="tag tag--pista-forte">Sem ovo</span>}
            {aveia && <span class="tag tag--alerta">{aveia === true ? 'Leva aveia' : 'Opção com aveia'}</span>}
          </div>
        )}
        <h2 class="h3" id={tituloId} tabindex="-1">{p.nome}</h2>
        <p class="preco-linha">
          <output class="price" data-preco-un>{formatarPreco(v0.preco ?? 0)}</output>
          <span class="t-s" data-escolha>{v0.rotulo}</span>
        </p>
        <div class="compartilhar-bloco">
          <Button variant="linha" size="sm" data-compartilhar {...dados} aria-label={`Compartilhar ${p.nome}`}><Icon name="solar:share-linear" />Compartilhar</Button>
          <div class="link-campo" data-link-campo hidden>
            <label class="t-s" for={`link-${p.id}`}>Não deu para copiar. Copie o link:</label>
            <input id={`link-${p.id}`} type="text" readonly value={dados['data-link']} data-link-input />
          </div>
        </div>
      </header>

      <p class="t-m">{p.descricao}</p>

      {p.variantes.length > 1 ? (
        <fieldset class="campo">
          <legend class="kicker">{v0.unidades ? 'Tamanho da caixa' : 'Peso'}</legend>
          <div class="seg">
            {p.variantes.map((v, i) => (
              <label><input type="radio" name="variante" value={v.id} data-rotulo={v.rotulo} data-preco={v.preco} data-unidades={v.unidades} checked={i === 0} /><span>{v.rotulo}</span></label>
            ))}
          </div>
        </fieldset>
      ) : (
        <input type="hidden" name="variante" value={v0.id} data-rotulo={v0.rotulo} data-preco={v0.preco} data-unidades={v0.unidades} />
      )}

      {opcoes.map((o) => (
        <fieldset class="campo" data-opcao data-artigo={o.artigo ?? 'o'} data-nome={o.rotulo.toLowerCase()}>
          <legend class="kicker">{o.rotulo}</legend>
          <div class="seg seg--solta">
            {o.valores.map((v) => <label><input type="radio" name={`opcao-${o.id}`} value={v.nome} data-rotulo={o.rotulo} /><span>{v.nome}{aveiaContaComoGluten() && v.contem?.includes('aveia') && ' (leva aveia)'}</span></label>)}
          </div>
        </fieldset>
      ))}

      {caixa && (
        <fieldset class="campo caixa">
          <legend class="kicker">Monte sua caixa</legend>
          <p class="caixa-conta"><output data-caixa-conta>0 de {v0.unidades}</output> <span class="t-s">brigadeiros escolhidos</span></p>
          <ul class="sabores">
            {caixa.valores.map((v) => (
              <li>
                <span class="sabor">{v.nome}</span>
                <div class="stepper" data-sabor={v.nome} data-min="0" data-max="99">
                  <button type="button" data-menos aria-label={`Menos ${v.nome}`}><Icon name="solar:minus-linear" /></button>
                  <output aria-live="polite">0</output>
                  <button type="button" data-mais aria-label={`Mais ${v.nome}`}><Icon name="solar:add-linear" /></button>
                </div>
              </li>
            ))}
          </ul>
        </fieldset>
      )}

      {(p.adicionais?.length || p.permiteSemOvo) && (
        <div class="campo chaves">
          {p.adicionais?.map((a) => (
            <label class="switch">
              <input type="checkbox" name="adicional" value={a.id} data-rotulo={a.rotulo} data-preco={a.preco} />
              <span class="trk"></span>{a.rotulo} <b>+{formatarPreco(a.preco)}</b>
            </label>
          ))}
          {p.permiteSemOvo && (
            <div>
              <label class="switch"><input type="checkbox" name="semovo" /><span class="trk"></span>Quero sem ovos</label>
              <p class="t-s recuo">Mesmo preço.</p>
            </div>
          )}
        </div>
      )}

      <fieldset class="campo">
        <legend class="kicker">Quantidade</legend>
        <div class="stepper" data-qtd data-min="1" data-max="20">
          <button type="button" data-menos aria-label="Diminuir quantidade"><Icon name="solar:minus-linear" /></button>
          <output aria-live="polite">1</output>
          <button type="button" data-mais aria-label="Aumentar quantidade"><Icon name="solar:add-linear" /></button>
        </div>
      </fieldset>

      <section class="surface bom-saber" aria-label="Bom saber">
        <span class="kicker">Bom saber</span>
        {contem.length > 0 && (
          <p><b>Contém:</b> <span data-com-ovo>{contem.join(', ')}</span>{contemSemOvo.length !== contem.length && <span data-sem-ovo hidden>{contemSemOvo.join(', ') || '—'}</span>}</p>
        )}
        {avisosAveia.map((aviso) => <p class="aviso">{aviso}</p>)}
        {podeConterSemRepetir(p).length > 0 && <p><b>Pode conter:</b> {rotulos(podeConterSemRepetir(p)).join(', ')}</p>}
        <p>{conserva}{/congel/i.test(conserva) && ` ${conservacao.observacaoCongelados}`}</p>
        <p data-prazo>Encomende com {prazo} dias de antecedência.</p>
        {brigadeiros && <p class="t-s">A partir de {regrasPedido.limiteBrigadeirosUnidades} brigadeiros no pedido, o prazo é de {regrasPedido.prazoEspecialDias} dias.</p>}
      </section>

      <section class="ingredientes" aria-label="Ingredientes">
        {ingredientes.length || acrescimos.length ? (
          <>
            <span class="kicker">Ingredientes</span>
            {/* com outras linhas, a lista do produto ganha nome: "Base" (sabores dos brigadeiros) ou "Massa" (bolo com cobertura) */}
            {ingredientes.length > 0 && <p class="t-m">{acrescimos.length > 0 && <b class="parte">{p.opcoes?.length ? 'Base:' : 'Massa:'}</b>} {ingredientes.join(', ')}.</p>}
            {acrescimos.length > 0 && (
              <ul class="t-m partes" role="list">{acrescimos.map((a) => <li><b>{a.nome}:</b> {a.ingredientes.join(', ')}.</li>)}</ul>
            )}
          </>
        ) : (
          <p class="t-s">Quer saber a receita completa? {redes.whatsapp ? <a href={redes.whatsapp} target="_blank" rel="noopener">Pergunte no WhatsApp.</a> : 'Pergunte no WhatsApp.'}</p>
        )}
      </section>
    </form>

    <footer class="folha-pe">
      <div class="total"><span class="t-s">Total</span><output class="price" data-total>{formatarPreco(v0.preco ?? 0)}</output></div>
      <Button data-adicionar><Icon name="solar:bag-4-linear" />Adicionar à sacola</Button>
      <p class="t-s motivo" data-motivo aria-live="polite"></p>
    </footer>

    <div class="toast" role="status" aria-live="polite"><Icon name="solar:check-circle-bold" /><span data-toast-texto></span><button type="button" data-toast-acao hidden></button></div>
  </div>
</dialog>

<style>
  /* base da folha/painel lateral (.folha, .folha-in, .alca, .folha-fechar, .folha-corpo, .folha-pe): global.css */
  /* desktop: o painel de Detalhes abre no meio da tela (a base .folha é lateral; a sacola continua assim) */
  @media (min-width: 860px) {
    .painel { --fora: 0 32px; inset: 0; margin: auto; width: min(480px, calc(100vw - 4rem)); height: min(860px, calc(100dvh - 4rem)); border-radius: 22px; opacity: 0; }
    .painel[open] { opacity: 1; }
    @starting-style { .painel[open] { opacity: 0; } }
  }
  @media (min-width: 860px) and (prefers-reduced-motion: reduce) { .painel { --fora: 0 0; } }

  /* galeria: fotos em scroll-snap, encostadas nas bordas */
  .galeria-bloco, .galeria.ph { margin-inline: -1.5rem; }
  .galeria { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; aspect-ratio: 4 / 3; flex: none; }
  .slide { flex: 0 0 100%; scroll-snap-align: start; }
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .galeria-bloco .dots-nav { display: flex; justify-content: center; gap: .5rem; margin-top: .4rem; }
  .dots-nav button { width: 22px; height: 24px; display: grid; align-items: center; transition: width .4s var(--e-out); }
  .dots-nav button::before { content: ''; height: 3px; border-radius: 2px; background: var(--line-2); transition: background-color .3s; }
  .dots-nav button.is-on { width: 40px; }
  .dots-nav button.is-on::before { background: var(--accent); }
  @media (min-width: 860px) { .galeria-bloco, .galeria.ph { margin-top: 0; } }

  .cabeca { display: flex; flex-direction: column; gap: .6rem; }
  .cabeca .h3 { font-size: clamp(1.8rem, 5vw, 2.3rem); outline: none; }
  .tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  .tag--caramelo { border-color: transparent; background: rgba(var(--accent-rgb), .16); color: var(--accent-ink); }
  /* com a onda dourada, --accent-ink cai abaixo de 4,5:1 no ponto mais claro: o texto escurece só neste selo */
  .tag--caramelo.tag--onda { color: var(--ink); }
  .preco-linha { display: flex; align-items: baseline; gap: .7rem; }
  .compartilhar-bloco :global(.btn) { --h: 44px; } /* alvo de toque */
  .compartilhar-bloco { display: flex; flex-direction: column; align-items: flex-start; gap: .6rem; }
  .link-campo { display: flex; flex-direction: column; gap: .3rem; width: 100%; }
  .link-campo input { width: 100%; min-height: 44px; padding: 0 .9rem; border: 1px solid var(--line-2); border-radius: var(--r-sm); background: var(--bg-2); color: var(--ink); font: inherit; font-size: .85rem; }
  .link-campo input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* aviso dentro do painel (fora dele o <dialog> modal esconderia o toast da página) */
  .painel .toast { position: absolute; bottom: 6.5rem; z-index: 4; }

  /* escolhas (DS · .seg, .switch, .stepper) */
  .campo { border: 0; margin: 0; padding: 0; min-width: 0; }
  .campo legend { margin-bottom: .7rem; padding: 0; }
  .chaves { display: flex; flex-direction: column; gap: 1rem; }
  .switch { position: relative; display: inline-flex; align-items: center; gap: .8rem; cursor: pointer; font-size: .875rem; color: var(--ink-2); }
  .switch b { font-weight: 600; color: var(--accent-ink); }
  .switch input { position: absolute; opacity: 0; pointer-events: none; }
  .trk { position: relative; flex: none; width: 46px; height: 26px; border-radius: var(--r-pill); background: rgba(var(--ink-rgb), .16); transition: background-color .35s; }
  .trk::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--surface-2); box-shadow: 0 2px 6px rgba(0, 0, 0, .25); transition: transform .45s var(--e-out); }
  .switch input:checked + .trk { background: var(--accent); }
  .switch input:checked + .trk::after { transform: translateX(20px); }
  .switch input:focus-visible + .trk { outline: 2px solid var(--accent); outline-offset: 3px; }
  .recuo { margin: .3rem 0 0 calc(46px + .8rem); }

  .caixa-conta { margin-bottom: .6rem; }
  .caixa-conta output { font-family: var(--serif); font-size: 1.5rem; font-weight: 500; color: var(--accent-ink); }
  .sabores { display: flex; flex-direction: column; }
  .sabores li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .55rem 0; border-bottom: 1px solid var(--line); }
  .sabores li:last-child { border-bottom: 0; }
  .sabor { font-family: var(--serif); font-size: 1.2rem; }

  .bom-saber { display: flex; flex-direction: column; gap: .55rem; padding: 1.3rem 1.4rem; font-size: .875rem; line-height: 1.55; color: var(--ink-2); }
  .bom-saber b { font-weight: 600; color: var(--ink); }
  .bom-saber .aviso { font-weight: 600; color: var(--danger); }
  .ingredientes a { color: var(--accent-ink); text-decoration: underline; text-underline-offset: .2em; }
  /* uma linha por sabor, massa, recheio ou cobertura */
  .partes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .35rem; }
  .partes b, .ingredientes .parte { font-weight: 600; color: var(--ink); }

  /* rodapé fixo: total + adicionar */
  .folha-pe { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .4rem 1.2rem; padding: .9rem 1.5rem calc(.9rem + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--surface); }
  .total { display: flex; flex-direction: column; gap: .15rem; }
  .folha-pe :global(.btn) { width: 100%; }
  .motivo { grid-column: 1 / -1; text-align: right; min-height: 1.2em; }
  .motivo:empty { display: none; }
</style>

<script>
  import { adicionar } from '../../scripts/sacola';
  import { ligarCompartilhar } from '../../scripts/compartilhar';
  import { prepararFolha } from '../../scripts/folha';

  const fmt = (v: number) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', minimumFractionDigits: Number.isInteger(v) ? 0 : 2 }).format(v);
  const paineis = new Map<string, HTMLDialogElement>();
  let origem: HTMLElement | null = null;
  let porPonteiro = false; // aberto com mouse/toque (click.detail > 0) ou pelo teclado (detail 0)
  let fechandoPeloHistorico = false;

  const urlCom = (id: string | null) => {
    const u = new URL(location.href);
    if (id) u.searchParams.set('produto', id); else u.searchParams.delete('produto');
    return u;
  };

  function abrir(id: string, empurrar = true) {
    const d = paineis.get(id);
    if (!d || d.open) return;
    d.showModal();
    d.querySelector('.folha-corpo')!.scrollTop = 0;
    d.querySelector<HTMLElement>('[tabindex="-1"]')!.focus({ preventScroll: true });
    if (empurrar) history.pushState({ painel: id }, '', urlCom(id));
  }

  // ---------- um painel ----------
  function iniciar(d: HTMLDialogElement) {
    // Compartilhar: folha nativa → copiar com aviso → link num campo já selecionado
    ligarCompartilhar(d.querySelectorAll<HTMLElement>('[data-compartilhar]'), () => {
      const campo = d.querySelector<HTMLElement>('[data-link-campo]')!;
      campo.hidden = false;
      const input = campo.querySelector<HTMLInputElement>('[data-link-input]')!;
      input.focus();
      input.select();
    });
    const form = d.querySelector('form')!;
    const q = <T extends Element>(s: string) => d.querySelector<T>(s);
    const valor = (st: Element) => Number(st.querySelector('output')!.value);
    const definir = (st: Element, n: number) => { st.querySelector('output')!.value = String(n); };
    const sabores = [...d.querySelectorAll<HTMLElement>('.stepper[data-sabor]')];
    const qtd = q<HTMLElement>('.stepper[data-qtd]')!;
    const botao = q<HTMLButtonElement>('[data-adicionar]')!;
    const motivo = q<HTMLElement>('[data-motivo]')!;

    const variante = () => form.querySelector<HTMLInputElement>('input[name=variante]:checked, input[name=variante][type=hidden]')!;
    const adicionais = () => [...form.querySelectorAll<HTMLInputElement>('input[name=adicional]:checked')];
    const unitario = () => Number(variante().dataset.preco) + adicionais().reduce((s, i) => s + Number(i.dataset.preco), 0);

    function atualizar() {
      const v = variante(), unidades = Number(v.dataset.unidades || 0), n = valor(qtd);
      q<HTMLOutputElement>('[data-preco-un]')!.value = fmt(unitario());
      q<HTMLElement>('[data-escolha]')!.textContent = v.dataset.rotulo!;
      q<HTMLOutputElement>('[data-total]')!.value = fmt(unitario() * n);
      qtd.querySelector<HTMLButtonElement>('[data-menos]')!.disabled = n <= Number(qtd.dataset.min);
      qtd.querySelector<HTMLButtonElement>('[data-mais]')!.disabled = n >= Number(qtd.dataset.max);

      let falta = '';
      for (const fs of d.querySelectorAll<HTMLElement>('fieldset[data-opcao]')) {
        if (!fs.querySelector('input:checked')) { falta = `Escolha ${fs.dataset.artigo} ${fs.dataset.nome}`; break; }
      }
      if (sabores.length) {
        // caixa menor do que o já escolhido: tira do último sabor para caber
        let soma = sabores.reduce((s, st) => s + valor(st), 0);
        for (let i = sabores.length - 1; soma > unidades && i >= 0; i--) {
          const tirar = Math.min(valor(sabores[i]), soma - unidades);
          definir(sabores[i], valor(sabores[i]) - tirar);
          soma -= tirar;
        }
        q<HTMLOutputElement>('[data-caixa-conta]')!.value = `${soma} de ${unidades}`;
        sabores.forEach((st) => {
          st.querySelector<HTMLButtonElement>('[data-mais]')!.disabled = soma >= unidades;
          st.querySelector<HTMLButtonElement>('[data-menos]')!.disabled = valor(st) <= 0;
        });
        const resto = unidades - soma;
        if (resto > 0) falta ||= `Faltam ${resto} brigadeiro${resto > 1 ? 's' : ''} para completar a caixa`;
      }
      botao.disabled = !!falta;
      motivo.textContent = falta;

      // brigadeiros: 7 dias a partir do limite de unidades (regra de site.ts, repetida aqui ao vivo)
      if (d.dataset.limite) {
        const dias = unidades * n >= Number(d.dataset.limite) ? d.dataset.prazoEsp : d.dataset.prazoMin;
        q<HTMLElement>('[data-prazo]')!.textContent = `Encomende com ${dias} dias de antecedência.`;
      }
      const semOvo = form.querySelector<HTMLInputElement>('input[name=semovo]')?.checked ?? false;
      const com = q<HTMLElement>('[data-com-ovo]'), sem = q<HTMLElement>('[data-sem-ovo]');
      if (com && sem) { com.hidden = semOvo; sem.hidden = !semOvo; }
    }

    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('change', atualizar);
    d.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest('[data-fechar]')) { d.close(); return; }
      const b = t.closest<HTMLButtonElement>('[data-mais], [data-menos]');
      if (!b || b.disabled) return;
      const st = b.closest<HTMLElement>('.stepper')!;
      const n = valor(st) + (b.hasAttribute('data-mais') ? 1 : -1);
      definir(st, Math.min(Number(st.dataset.max), Math.max(Number(st.dataset.min), n)));
      atualizar();
    });

    botao.addEventListener('click', () => {
      if (botao.disabled) return;
      const opcoes: Record<string, string> = {};
      form.querySelectorAll<HTMLInputElement>('fieldset[data-opcao] input:checked').forEach((i) => { opcoes[i.name.replace('opcao-', '')] = i.value; });
      const escolhidos: Record<string, number> = {};
      sabores.forEach((st) => { if (valor(st)) escolhidos[st.dataset.sabor!] = valor(st); });
      // a sacola guarda ids; preço e nomes saem do cardápio de novo (src/lib/pedido)
      adicionar({
        id: d.dataset.produto!, variante: variante().value, adicionais: adicionais().map((i) => i.value), opcoes, sabores: escolhidos,
        semOvo: form.querySelector<HTMLInputElement>('input[name=semovo]')?.checked ?? false, quantidade: valor(qtd),
      });
      d.close();
    });

    // galeria: o ponto acompanha a foto à vista; tocar no ponto leva até ela
    const galeria = q<HTMLElement>('.galeria'), pontos = [...d.querySelectorAll<HTMLButtonElement>('.dots-nav button')];
    if (galeria && pontos.length) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.intersectionRatio < .6) return;
        const i = [...galeria.children].indexOf(e.target);
        pontos.forEach((p, j) => p.classList.toggle('is-on', i === j));
      }), { root: galeria, threshold: .6 });
      [...galeria.children].forEach((s) => io.observe(s));
      pontos.forEach((p, i) => p.addEventListener('click', () => galeria.scrollTo({ left: i * galeria.clientWidth, behavior: 'smooth' })));
    }

    prepararFolha(d); // tocar fora e arrastar a alça fecham (src/scripts/folha.ts)

    d.addEventListener('close', () => {
      // o foco volta ao botão de origem; aberto com mouse/toque, volta sem anel (senão a barra do card fica em pé)
      if (origem) {
        origem.focus({ preventScroll: true, focusVisible: !porPonteiro } as FocusOptions);
        if (porPonteiro && origem.matches(':focus-visible')) origem.blur();
      }
      origem = null;
      if (fechandoPeloHistorico) { fechandoPeloHistorico = false; return; }
      if (history.state?.painel) history.back(); // tira a entrada que o abrir criou
      else history.replaceState(null, '', urlCom(null)); // painel aberto pelo link direto
    });

    atualizar();
  }

  document.querySelectorAll<HTMLDialogElement>('dialog.painel').forEach((d) => { paineis.set(d.dataset.produto!, d); iniciar(d); });

  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-abrir]');
    if (!b) return;
    origem = b;
    porPonteiro = (e as MouseEvent).detail > 0;
    abrir(b.dataset.abrir!);
  });

  // voltar/avançar do navegador (e do aparelho) fecha ou abre o painel conforme a URL
  addEventListener('popstate', () => {
    const id = new URL(location.href).searchParams.get('produto');
    const aberto = document.querySelector<HTMLDialogElement>('dialog.painel[open]');
    if (aberto && aberto.dataset.produto !== id) { fechandoPeloHistorico = true; aberto.close(); }
    if (id && aberto?.dataset.produto !== id) abrir(id, false);
  });

  const inicial = new URL(location.href).searchParams.get('produto');
  if (inicial) abrir(inicial, false);
</script>
