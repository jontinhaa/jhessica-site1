---
// Card de produto do /pedido (DS · .produto): foto 4:5, etiquetas, nome, descrição, preço, "Detalhes" e a .add-bar.
// .add-bar: "Adicionar à sacola" direto quando não há nada a escolher; senão "Escolher" abre o painel.
// Tilt com reflexo só com mouse; no toque a barra fica sempre à vista.
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { formatarPreco, getImagensProduto, precosDe, type Produto } from '../../data/cardapio';
import { dadosCompartilhar } from '../../lib/pedido/compartilhar';

interface Props { produto: Produto }
const { produto: p } = Astro.props;

const { capa } = getImagensProduto(p.id);
const precos = precosDe(p);
const aPartirDe = new Set(precos).size > 1;
const direto = p.variantes.length === 1 && !p.opcoes?.length;
const semOvo = !p.alergenos.contem.includes('ovo');
const dados = Object.fromEntries(Object.entries(dadosCompartilhar(p, Astro.site ?? Astro.url.origin, import.meta.env.BASE_URL)).map(([k, v]) => [`data-${k}`, v]));
---

<article class:list={['produto', !p.disponivel && 'is-out']} data-tilt data-rv>
  <div class:list={['produto-pic', !capa && ['ph', 'ph-empty']]} data-ph={capa ? undefined : `produtos/${p.id}/capa`}>
    {/* card ≈ 450px no desktop: até 1200px cobre tela de densidade 2+; webp 85 evita borrar o granulado e as texturas */}
    {capa && <Image src={capa} alt={p.nome} widths={[360, 720, 960, 1200]} sizes="(max-width: 359px) 100vw, (max-width: 1023px) 50vw, (max-width: 1400px) 33vw, 450px" quality={85} loading="lazy" />}
    <div class="tags">
      {p.maisPedido && <span class="tag tag--vidro">Mais pedido</span>}
      {semOvo && <span class="tag tag--pista-forte">Sem ovo</span>}
    </div>
    {!p.disponivel ? (
      <button class="add-bar" type="button" disabled>Esgotado nesta semana</button>
    ) : direto ? (
      <button class="add-bar" type="button" data-add={p.id} data-variante={p.variantes[0].id}>
        <span class="add-longo">Adicionar à sacola</span><span class="add-curto">Adicionar</span><Icon name="solar:bag-4-linear" />
      </button>
    ) : (
      <button class="add-bar" type="button" data-abrir={p.id}>Escolher<Icon name="solar:arrow-right-linear" /></button>
    )}
  </div>
  <div class="produto-body">
    <h3 class="h4">{p.nome}</h3>
    <p class="t-m">{p.descricao}</p>
    <div class="produto-row">
      <span class="price">{aPartirDe && <small>a partir de</small>}{formatarPreco(Math.min(...precos))}</span>
      <div class="produto-acoes">
        <button class="compartilhar" type="button" data-compartilhar {...dados} aria-label={`Compartilhar ${p.nome}`}>
          <Icon name="solar:share-linear" /><span>Compartilhar</span>
        </button>
        <button class="link-r" type="button" data-abrir={p.id} aria-label={`Detalhes: ${p.nome}`}>
          Detalhes
          <svg class="risco" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 8.5C18 4 34 10 52 6.5S88 9.5 104 5.8c6-1.2 10-.8 14 .7" /></svg>
        </button>
      </div>
    </div>
  </div>
  <i class="glare" aria-hidden="true"></i>
</article>

<style>
  .produto {
    position: relative; display: flex; flex-direction: column; height: 100%; border-radius: var(--r-lg); overflow: hidden;
    background: var(--surface); border: 1px solid var(--line);
    transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: translate .6s var(--e-out), box-shadow .6s var(--e-std), border-color .6s var(--e-std);
  }
  .produto-pic { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--bg-2); }
  .produto-pic img { width: 100%; height: 100%; object-fit: cover; scale: 1.02; transform: translate3d(var(--px, 0px), var(--py, 0px), 0); transition: scale 1.2s var(--e-zoom), filter .6s; }
  .tags { position: absolute; left: .8rem; top: .8rem; z-index: 2; display: flex; flex-wrap: wrap; gap: .35rem; }
  .add-bar {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; height: 50px; display: flex; align-items: center; justify-content: center; gap: .6rem;
    background: var(--ink); color: var(--bg); font-size: .625rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase;
    transform: translateY(101%); transition: transform .5s var(--e-out), background-color .3s;
  }
  .add-bar:hover:not(:disabled) { background: var(--accent); color: var(--on-accent); }
  .add-bar:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  .add-bar.is-added { background: var(--pista); color: #fff; }
  .add-curto { display: none; }
  .produto-body { display: flex; flex-direction: column; gap: .5rem; flex: 1; padding: 1.4rem; }
  .produto-body .h4 { font-size: clamp(1.05rem, 2.4vw, 1.45rem); text-wrap: balance; }
  .produto-body .t-m { flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .produto-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .6rem 1rem; margin-top: .6rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .produto-row .link-r { font-size: .8rem; }
  .produto-acoes { display: flex; align-items: center; gap: .3rem 1rem; }
  .compartilhar { display: inline-flex; align-items: center; gap: .35rem; min-height: 44px; font-size: .8rem; color: var(--ink-2); transition: color .3s var(--e-std); }
  .compartilhar:hover { color: var(--accent-ink); }
  .compartilhar:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--r-sm); }
  .produto.is-out .produto-pic img { filter: grayscale(.85) brightness(.9); }
  .produto.is-out .add-bar { transform: none; background: rgba(var(--ink-rgb), .6); cursor: not-allowed; }

  /* mouse: sobe, aproxima a foto e mostra a barra no hover e no foco do TECLADO (:focus-visible; com :focus-within,
     o foco devolvido ao fechar o painel deixava a barra presa em pé) */
  @media (hover: hover) and (pointer: fine) {
    .produto:hover { translate: 0 -6px; box-shadow: var(--shadow-2); border-color: rgba(var(--accent-rgb), .42); }
    .produto:hover .produto-pic img { scale: 1.08; }
    .produto:hover .add-bar, .produto:has(:focus-visible) .add-bar { transform: none; }
  }
  /* toque: barra sempre à vista, sem tilt */
  @media not ((hover: hover) and (pointer: fine)) {
    .add-bar { transform: none; }
    .glare { display: none; }
  }
  .glare { position: absolute; inset: 0; z-index: 3; pointer-events: none; border-radius: inherit; opacity: var(--go, 0); background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgba(255, 255, 255, .32), rgba(255, 255, 255, 0) 55%); mix-blend-mode: soft-light; transition: opacity .5s; }

  /* celular: card compacto, sem descrição */
  @media (max-width: 639px) {
    .produto-body { padding: .85rem; gap: .3rem; }
    .produto-body .t-m { display: none; }
    .produto-row { margin-top: .3rem; padding-top: .7rem; }
    .produto-row .price { font-size: 1.15rem; }
    .produto-row .link-r { font-size: .75rem; }
    .compartilhar { font-size: .75rem; min-width: 44px; justify-content: center; }
    .compartilhar span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .add-bar { height: 42px; letter-spacing: .14em; }
    .add-longo { display: none; }
    .add-curto { display: inline; }
    .tags { left: .5rem; top: .5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .produto, .produto-pic img { transition: none; } }
</style>

<script>
  import { podeInclinar, tilt } from '../../scripts/tilt';
  import { adicionar, aviso } from '../../scripts/sacola';
  import { ligarCompartilhar } from '../../scripts/compartilhar';

  // sem folha nativa e sem copiar: o próprio aviso mostra o link para a pessoa copiar à mão
  ligarCompartilhar(document.querySelectorAll<HTMLElement>('.produto [data-compartilhar]'), (link) => aviso(`Copie o link: ${link}`, undefined, 9000));

  if (podeInclinar()) document.querySelectorAll<HTMLElement>('.produto[data-tilt]').forEach((el) => tilt(el, { move: 8 }));

  // produto sem escolhas: entra direto na sacola com a única variante
  document.querySelectorAll<HTMLButtonElement>('.add-bar[data-add]').forEach((b) => b.addEventListener('click', () => {
    adicionar({ id: b.dataset.add!, variante: b.dataset.variante!, adicionais: [], opcoes: {}, sabores: {}, semOvo: false, quantidade: 1 });
    b.classList.add('is-added');
    setTimeout(() => b.classList.remove('is-added'), 1400);
  }));
</script>
