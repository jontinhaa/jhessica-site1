---
// Marca: forminha de papel com 18 recortes + pontilhado + J itálico. Cor = currentColor do .mark.
interface Props {
  /** Mostra "Jhessica / confeitaria artesanal" ao lado da marca. */
  text?: boolean;
  href?: string;
}
import { site } from '../../data/site';
import { scallop } from './mark';
const { text = true, href = '/' } = Astro.props;
---

<a class="brand" href={href} aria-label={`${site.name}, ${site.tagline}`}>
  <svg class="mark" viewBox="0 0 80 80" aria-hidden="true">
    <path d={scallop} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
    <circle cx="40" cy="40" r="23" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2.5 3.2" opacity=".7" />
    <text x="40.5" y="51" text-anchor="middle" style="font-family: var(--serif)" font-style="italic" font-size="31" fill="currentColor">J</text>
  </svg>
  {text && (
    <span class="bt">
      <b>{site.name}</b>
      <small>{site.tagline}</small>
    </span>
  )}
</a>

<style>
  .brand { display: flex; align-items: center; gap: .8rem; flex: none; }
  .mark { width: 44px; height: 44px; color: var(--accent); transition: transform .5s var(--e-out), color .5s; }
  .brand:hover .mark { transform: rotate(-12deg) scale(1.05); color: var(--accent-2); }
  .bt { display: flex; flex-direction: column; gap: .28rem; }
  .bt b { font-family: var(--serif); font-weight: 400; font-size: 1.15rem; line-height: 1; letter-spacing: .3em; text-transform: uppercase; }
  .bt small { font-size: .5rem; font-weight: 600; letter-spacing: .34em; text-transform: uppercase; color: var(--accent-ink); }
  @media (max-width: 640px) { .bt small { display: none; } }
</style>
