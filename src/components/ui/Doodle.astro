  circulo: ['0 0 200 80', 'M150 12C110 2 40 6 16 26-2 42 22 70 90 72c60 2 102-14 98-36-3-18-38-28-76-26'],
} as const;

interface Props {
  name: keyof typeof doodles;
  boil?: boolean;
  class?: string;
}
const { name, boil = true, class: className } = Astro.props;
const [viewBox, d] = doodles[name];
---

<svg class:list={['doodle', boil && 'boil', className]} viewBox={viewBox} aria-hidden="true">
  <path d={d} pathLength="1" />
</svg>

<style>
  .doodle { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }
  .boil { animation: boil .5s steps(1) infinite; }
  @keyframes boil {
    0% { transform: rotate(0) translate(0, 0); }
    33% { transform: rotate(-2.5deg) translate(.6px, -.4px); }
    66% { transform: rotate(2deg) translate(-.5px, .5px); }
  }
</style>
