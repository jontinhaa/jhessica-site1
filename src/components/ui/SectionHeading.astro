---
// Cabeçalho de seção (padrão Nereo): sobretítulo "NN · RÓTULO" com fio + título com o final em itálico caramelo.
// Nas seções da home o número é a posição em src/data/site.ts (secoes). Texto de apoio opcional pelo slot "aside".
interface Props {
  /** 1 → "01"; texto passa direto (ex.: "404"); sem número, o sobretítulo é só o rótulo. */
  numero?: number | string;
  rotulo: string;
  titulo: string;
  tituloDestaque: string;
  as?: 'h1' | 'h2' | 'h3';
  center?: boolean;
}
const { numero, rotulo, titulo, tituloDestaque, as: Tag = 'h2', center = false } = Astro.props;
const n = typeof numero === 'number' ? String(numero).padStart(2, '0') : numero;
const sobretitulo = n ? `${n} · ${rotulo}` : rotulo;
---

<header class:list={['head', center && 'head--center']}>
  <div>
    <div class="eyebrow-line"><i aria-hidden="true"></i><span>{sobretitulo}</span></div>
    <Tag class="h2">{titulo}{' '}<em>{tituloDestaque}</em></Tag>
  </div>
  {Astro.slots.has('aside') && <p class="aside"><slot name="aside" /></p>}
</header>

<style>
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 4rem; }
  .head .h2 { margin-top: 1.1rem; }
  .head--center { flex-direction: column; align-items: center; text-align: center; }
  .head--center .eyebrow-line { justify-content: center; }
  .aside { max-width: 25rem; font-size: .9rem; color: var(--muted); }
</style>
