---
// INGREDIENTES · o que a receita tem e não tem, sem prometer além dos dados.
// Frases condicionais (açúcar, cozinha) e a lista "O que entra" vêm de `compromisso` em src/data/site.ts:
// enquanto um dado for null, a frase não afirma nada. Alérgenos por produto ficam em src/data/cardapio.ts.
// Foto PROVISÓRIA: ver src/assets/images/ingredientes/FONTES-PROVISORIAS.md.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import Doodle from '../ui/Doodle.astro';
import CenaIngrediente from '../ui/CenaIngrediente.astro';
import { compromisso, redes, rotulosAlergenos, textoAcucar, textoCozinha, type Secao } from '../../data/site';

interface Props { secao: Secao; numero: number }
const { secao, numero } = Astro.props;

const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/ingredientes/destaque.{jpg,jpeg,png,webp}', { eager: true });
const foto = Object.values(fotos)[0]?.default;

const zeros = ['ingredientes com glúten', 'com leite ou derivados', 'conservantes'];
const cozinha = textoCozinha();
const entram = compromisso.ingredientesQueEntram;
// glúten e leite já têm o bloco deles; aqui só os "outros"
const outros = Object.entries(rotulosAlergenos).filter(([k]) => k !== 'gluten' && k !== 'leite').map(([, r]) => r);
---

<section class="sec sec--tint" id={secao.id}>
  <div class="wrapx">
    <SectionHeading numero={numero} rotulo={secao.rotulo} titulo={secao.titulo} tituloDestaque={secao.tituloDestaque} />
    <div class="sec-body">
      <div class="split rev">
        <figure class:list={['media', !foto && ['ph', 'ph-empty', 'ph--caramelo']]} data-ph={foto ? undefined : 'ingredientes/destaque.webp'} data-clip>
          {foto && (
            // TODO: alt final com a foto real
            <Image class="par" src={foto} alt="Tigela de farinha com colher de pau sobre a mesa de madeira do ateliê, com panelas de cobre ao fundo"
              widths={[400, foto.width]} sizes="(max-width: 860px) calc(100vw - 40px), 55vw" loading="lazy" data-par />
          )}
          <figcaption class="cap">Mesa do ateliê</figcaption>
        </figure>

        <div class="texto">
          <p class="lead" data-rv>Cada receita foi pensada para quem tem restrição e para quem só quer comer melhor, sem abrir mão do sabor.</p>

          <ul class="zeros">
            {zeros.map((legenda, i) => (
              <li data-rv>
                <span class="num"><span class="numeral">0</span>{i === 0 && <span class="rabisco"><Doodle name="trigo" /></span>}</span>
                <span class="micro">{legenda}</span>
              </li>
            ))}
          </ul>

          <p class="t-m" data-rv>{textoAcucar()}</p>

          <aside class="surface bom-saber" data-rv>
            <span class="well"><Icon name="solar:leaf-linear" /></span>
            <div>
              <span class="kicker">Bom saber</span>
              <h3 class="h4">Sem leite não é o mesmo que sem lactose.</h3>
              <p class="t-m">Um produto sem lactose ainda pode ter leite. Aqui, as receitas não levam leite nem derivados: nada de manteiga, creme de leite, leite condensado ou leite em pó.</p>
            </div>
          </aside>

          {cozinha && (
            <p class="t-m cozinha" data-rv>
              {cozinha}
              {redes.whatsapp && <> <a href={redes.whatsapp} target="_blank" rel="noopener">Falar no WhatsApp</a></>}
            </p>
          )}

          <div class="alergenos" data-rv>
            <h3 class="t-bold-s">Outros alérgenos</h3>
            <ul class="tags">{outros.map((r) => <li class="tag">{r}</li>)}</ul>
            <p class="t-s">Todas as receitas levam ovo e oleaginosas (amêndoas ou castanha de caju) e podem conter soja. Tem opção sem ovos: é só pedir.</p>
            <a class="link-r" href="/pedido">
              Ver o cardápio<Icon name="solar:arrow-right-linear" />
              <svg class="risco" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 8.5C18 4 34 10 52 6.5S88 9.5 104 5.8c6-1.2 10-.8 14 .7" /></svg>
            </a>
          </div>
        </div>
      </div>

      {entram.length > 0 && (
        <div class="entram">
          <div class="entram-top">
            <h3 class="t-bold-s">O que entra</h3>
            {/* dica conforme o aparelho: mouse, toque em grade (tablet) ou toque no carrossel (celular) */}
            <p class="dica">
              <span class="hand"><span class="d-mouse">passe o mouse para ver o porquê</span><span class="d-toque">toque para virar</span><span class="d-arraste">arraste e toque para virar</span></span>
              <Doodle name="seta" boil={false} />
            </p>
          </div>
          <ul class="flips">
            {entram.map((item, i) => (
              <li data-rv>
                <button class={`flip fl-${(i % 4) + 1}`} type="button" aria-pressed="false" style={`--i:${i}`}>
                  <span class="flip-in">
                    <span class="flip-f">
                      <span class="n">{String(i + 1).padStart(2, '0')}</span>
                      <span class="rab"><Doodle name={item.rabisco} boil={false} /></span>
                      <span class="pe"><span class="h4">{item.nome}</span><span class="micro porque">por quê? <Icon name="solar:refresh-linear" /></span></span>
                    </span>
                    <span class="flip-b">
                      <span class="kicker">{String(i + 1).padStart(2, '0')} · {item.nome}</span>
                      <span class="t-m">{item.porque}</span>
                      <span class="lenda" aria-hidden="true">{item.legenda}</span>
                      <CenaIngrediente cena={item.cena} />
                    </span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <div class="dots-nav">
            {entram.map((item, i) => <button type="button" class:list={[i === 0 && 'is-on']} aria-label={`Ir para ${item.nome}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .texto { display: flex; flex-direction: column; align-items: flex-start; gap: 1.8rem; }
  /* contraste ≥ 4.5:1 (medido): véu da legenda mais escuro que o do DS (.42), textos pequenos um tom mais fortes */
  .media .cap { background: rgba(20, 13, 10, .72); }
  .t-bold-s { color: color-mix(in srgb, var(--accent-ink) 80%, var(--ink)); }
  .alergenos .t-s { color: var(--ink-2); }
  .texto .lead { max-width: 40ch; }

  /* três zeros lado a lado; o rabisco de trigo acompanha o primeiro */
  .zeros { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; width: 100%; }
  .zeros li { display: flex; flex-direction: column; align-items: flex-start; gap: .6rem; }
  .num { position: relative; }
  .zeros .micro { font-size: .75rem; line-height: 1.45; letter-spacing: .12em; color: var(--ink-2); } /* legenda é frase: 12px, acima dos .59rem do DS */
  /* rabisco solto ao lado do primeiro zero, sem ocupar lugar (as legendas ficam alinhadas) */
  .rabisco { position: absolute; left: 100%; top: 50%; translate: 0 -50%; margin-left: .2rem; width: .8em; height: .8em; font-size: clamp(3rem, 6vw, 5rem); color: var(--accent); }
  .rabisco :global(svg) { width: 100%; height: 100%; }

  .zeros + .t-m { margin-top: -.8rem; } /* a linha do açúcar é nota dos zeros */
  .bom-saber { display: flex; gap: 1.2rem; padding: 1.5rem; }
  .bom-saber .kicker { margin-bottom: .5rem; }
  .bom-saber .h4 { font-size: 1.35rem; margin-bottom: .6rem; }

  .cozinha a { color: var(--accent-ink); text-decoration: underline; text-underline-offset: .2em; }
  .alergenos { display: flex; flex-direction: column; align-items: flex-start; gap: .8rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; }
  .alergenos .link-r { margin-top: .6rem; }

  /* ---------- "O que entra": cartões que viram (DS · .flip) ---------- */
  .entram { margin-top: clamp(3rem, 6vw, 5rem); }
  .entram-top { display: flex; flex-wrap: wrap; align-items: flex-end; gap: .2rem 1.4rem; margin-bottom: 1.6rem; }
  .dica { display: flex; align-items: flex-end; gap: .3rem; }
  .dica .hand { font-size: 1.5rem; line-height: 1; }
  .dica :global(.doodle) { width: 44px; height: 33px; color: var(--accent); translate: 0 .9rem; }
  .d-toque, .d-arraste { display: none; }
  @media (hover: none) { .d-mouse { display: none; } .d-toque { display: inline; } }
  @media (hover: none) and (max-width: 639px) { .d-toque { display: none; } .d-arraste { display: inline; } }

  .flips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  /* altura = cena (metade da largura do cartão, 280 × 140) + texto do verso */
  .flips li { container-type: inline-size; }
  .flip { display: block; width: 100%; height: 360px; height: calc(50cqi + 10rem); perspective: 1000px; text-align: left; }
  .flip-in { position: relative; display: block; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .8s var(--e-flip); }
  .flip.is-flipped .flip-in, .flip:focus-visible .flip-in { transform: rotateY(180deg); }
  @media (hover: hover) { .flip:hover .flip-in { transform: rotateY(180deg); } }
  .flip:focus-visible { outline: none; }
  .flip:focus-visible .flip-in { box-shadow: 0 0 0 2px var(--accent); border-radius: var(--r-lg); }
  .flip-f, .flip-b { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 1.5rem; border-radius: var(--r-lg); -webkit-backface-visibility: hidden; backface-visibility: hidden; overflow: hidden; }
  .flip-f { color: #FBF3E6; }
  .flip-f .n { font-family: var(--serif); font-style: italic; font-size: 1.1rem; opacity: .9; }
  .pe { position: relative; z-index: 1; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
  .porque { display: inline-flex; align-items: center; gap: .35em; flex: none; color: inherit; font-size: .625rem; }

  /* rabisco do ingrediente: desenha uma vez ao entrar (.desenhou, em cascata) e só ferve (.boil, posto pelo script)
     no cartão em foco: hover/Tab no desktop, cartão central do carrossel no celular */
  .rab { position: absolute; top: 1.1rem; right: 1.1rem; width: 72px; height: 72px; color: var(--on-band); opacity: .9; }
  .rab :global(.doodle) { width: 100%; height: 100%; }
  .rv-on .rab :global(path) { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .9s var(--e-flip) calc(var(--i) * 120ms); }
  .rv-on .flips.desenhou .rab :global(path) { stroke-dashoffset: 0; }
  .rab :global(.boil) { animation-delay: calc(var(--i) * -.17s); } /* vizinhos nunca tremem juntos */

  /* piscadinha do 1º cartão no celular, uma vez por visita */
  .flip.espia .flip-in { animation: espia .9s var(--e-flip) .5s; }
  @keyframes espia { 45% { transform: rotateY(-35deg); } }
  .flip-f::after { content: ''; position: absolute; inset: 0; background: var(--grain-img); opacity: .14; mix-blend-mode: overlay; pointer-events: none; }
  .flip-b { transform: rotateY(180deg); justify-content: flex-start; gap: .55rem; padding-bottom: 0; background: var(--surface); border: 1px solid var(--line); }
  .flip-b .t-m { max-width: 34ch; }
  /* legenda à mão: accent-ink (e não accent) para passar de 4,5:1 nesse tamanho */
  .lenda { margin-top: auto; font-family: var(--hand); font-size: 1.3rem; line-height: 1.2; color: var(--accent-ink); text-align: right; }
  .flip-b .cena { flex: none; width: calc(100% + 3rem); margin: .35rem -1.5rem 0; } /* encostada nas bordas e na base */
  .fl-1 .flip-f { background: #3A2418; }
  .fl-2 .flip-f { background: #9A5A22; } /* DS: #A8652A; um tom abaixo para o texto claro passar de 4,5:1 */
  .fl-3 .flip-f { background: #7A2835; }
  .fl-4 .flip-f { background: #5B6B34; }

  .dots-nav { display: none; }
  @media (max-width: 1023px) { .flips { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    /* zeros empilhados, com divisória fina (.hair) entre eles */
    .zeros { grid-template-columns: 1fr; gap: 0; }
    .zeros li { display: grid; grid-template-columns: 5.25rem 1fr; align-items: center; padding: 1rem 0; }
    .num { justify-self: start; }
    .zeros li + li { border-top: 1px solid var(--line); }
    .bom-saber { width: 100%; }
  }
  @media (max-width: 640px) {
    .bom-saber { gap: 1rem; padding: 1.25rem; }
    .bom-saber .well { width: 40px; height: 40px; font-size: 16px; }
  }

  @media (max-width: 639px) {
    /* carrossel: ~1,15 cartão à vista, rolagem lateral (intencional) com encaixe */
    .flips { position: relative; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--pad) * -1); padding: .25rem var(--pad) .5rem; scroll-padding-inline: var(--pad); }
    .flips li { flex: 0 0 87%; scroll-snap-align: start; }
    .rv-on .flips [data-rv] { opacity: 1; translate: none; } /* fora da tela na horizontal, o revelar chegaria atrasado; a entrada é o desenho */
    .rab { width: 64px; height: 64px; }
    /* DS .dots-nav (traço de 3px); o botão tem 24px de altura para o dedo acertar */
    .dots-nav { display: flex; gap: .5rem; margin-top: .9rem; }
    .dots-nav button { width: 22px; height: 24px; display: grid; align-items: center; transition: width .4s var(--e-out); }
    .dots-nav button::before { content: ''; height: 3px; border-radius: 2px; background: var(--line-2); transition: background-color .3s; }
    .dots-nav button.is-on { width: 40px; }
    .dots-nav button.is-on::before { background: var(--accent); }
  }

  /* movimento reduzido: sem giro; frente e verso trocam com fade; rabisco já desenhado e parado */
  @media (prefers-reduced-motion: reduce) {
    .rv-on .rab :global(path) { stroke-dashoffset: 0; transition: none; }
    .rab :global(.boil) { animation: none; }
    .flip.espia .flip-in { animation: none; }
    .flip .flip-in { transform: none !important; }
    .flip-b { transform: none; opacity: 0; }
    .flip-f, .flip-b { transition: opacity .4s !important; }
    .flip.is-flipped .flip-f, .flip:focus-visible .flip-f { opacity: 0; }
    .flip.is-flipped .flip-b, .flip:focus-visible .flip-b { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) and (hover: hover) {
    .flip:hover .flip-f { opacity: 0; }
    .flip:hover .flip-b { opacity: 1; }
  }
</style>

<script>
  const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const comMouse = matchMedia('(hover: hover)');
  const carrossel = matchMedia('(max-width: 639px)');

  document.querySelectorAll<HTMLElement>('.entram').forEach((bloco) => {
    const trilho = bloco.querySelector<HTMLElement>('.flips')!;
    const cartas = [...trilho.querySelectorAll<HTMLButtonElement>('.flip')];
    const pontos = [...bloco.querySelectorAll<HTMLButtonElement>('.dots-nav button')];
    const ferver = (b: HTMLElement, on: boolean) => { if (!reduz) b.querySelector('.doodle')?.classList.toggle('boil', on); };

    // cena do verso: só anima com o cartão virado (toque, hover ou Tab) E na tela
    const estado = new Map(cartas.map((b) => [b, { tela: false, mouse: false, foco: false }]));
    const cena = (b: HTMLButtonElement) => {
      const e = estado.get(b)!;
      b.classList.toggle('cena-viva', !reduz && e.tela && (b.getAttribute('aria-pressed') === 'true' || e.mouse || e.foco));
    };
    const naTela = new IntersectionObserver((es) => es.forEach((e) => {
      const b = e.target as HTMLButtonElement;
      estado.get(b)!.tela = e.isIntersecting;
      cena(b);
    }), { threshold: .15 });
    cartas.forEach((b) => naTela.observe(b));

    // toque vira (aria-pressed); arrastar o carrossel não vira
    cartas.forEach((b) => {
      let x0 = 0, y0 = 0, arrastou = false;
      b.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; arrastou = false; });
      b.addEventListener('pointermove', (e) => { if (Math.hypot(e.clientX - x0, e.clientY - y0) > 10) arrastou = true; });
      b.addEventListener('click', () => {
        if (arrastou) return;
        b.setAttribute('aria-pressed', String(b.classList.toggle('is-flipped')));
        cena(b);
      });
      // desktop: ferve no hover e no foco pelo teclado
      const e = estado.get(b)!;
      b.addEventListener('pointerenter', (ev) => {
        if (!comMouse.matches || ev.pointerType !== 'mouse') return;
        ferver(b, true); e.mouse = true; cena(b);
      });
      b.addEventListener('pointerleave', (ev) => {
        if (ev.pointerType !== 'mouse') return;
        if (b !== document.activeElement) ferver(b, false);
        e.mouse = false; cena(b);
      });
      // foco pelo teclado (:focus-visible) é o que vira o cartão; clique de mouse não conta
      b.addEventListener('focus', () => { if (b.matches(':focus-visible')) { ferver(b, true); e.foco = true; cena(b); } });
      b.addEventListener('blur', () => { ferver(b, false); e.foco = false; cena(b); });
    });

    // desenha os rabiscos uma vez; no celular, a piscadinha do 1º cartão (uma vez por visita)
    new IntersectionObserver((es, io) => {
      if (!es[0].isIntersecting) return;
      io.disconnect();
      trilho.classList.add('desenhou');
      if (reduz || !carrossel.matches) return;
      try {
        if (sessionStorage.getItem('espiou')) return;
        sessionStorage.setItem('espiou', '1');
      } catch { /* sem storage: pisca mesmo assim */ }
      cartas[0].classList.add('espia');
      cartas[0].addEventListener('animationend', () => cartas[0].classList.remove('espia'), { once: true });
    }, { threshold: .3 }).observe(trilho);

    // carrossel: o cartão central (≥ 60% à vista) ferve e acende o ponto
    const visivel = new Map<Element, number>();
    const io = new IntersectionObserver((es) => {
      if (!carrossel.matches) return;
      es.forEach((e) => visivel.set(e.target, e.intersectionRatio));
      cartas.forEach((b, i) => {
        const on = (visivel.get(b.parentElement!) ?? 0) >= .6;
        ferver(b, on);
        if (on) pontos.forEach((p, j) => { p.classList.toggle('is-on', j === i); p.toggleAttribute('aria-current', j === i); });
      });
    }, { root: trilho, threshold: [0, .6, 1] });
    cartas.forEach((b) => io.observe(b.parentElement!));

    // tocar num ponto rola até o cartão
    pontos.forEach((p, i) => p.addEventListener('click', () => {
      const li = cartas[i].parentElement!, primeiro = cartas[0].parentElement!;
      trilho.scrollTo({ left: li.offsetLeft - primeiro.offsetLeft, behavior: reduz ? 'auto' : 'smooth' });
    }));
  });
</script>
