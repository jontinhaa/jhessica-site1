---
// CARDÁPIO · vitrine de categorias (design system · Padrão C, bento com legenda revelada).
// Cada bloco leva a /pedido#{categoria}. Nome, tipo, chamada e preço vêm de src/data/cardapio.ts.
// Fotos em src/assets/images/cardapio/{id}.(jpg|png|webp); sem o arquivo, o bloco mostra o placeholder .ph.
// PROVISÓRIAS: ver src/assets/images/cardapio/FONTES-PROVISORIAS.md.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import Doodle from '../ui/Doodle.astro';
import type { Secao } from '../../data/site';
import { categorias, formatarPreco, getProdutosPorCategoria, precoMinimo, type CategoriaId } from '../../data/cardapio';

interface Props { secao: Secao; numero: number }
const { secao, numero } = Astro.props;

const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/cardapio/*.{jpg,jpeg,png,webp}', { eager: true });
const fotoDe = (id: string) => Object.entries(fotos).find(([caminho]) => caminho.split('/').pop()!.replace(/\.\w+$/, '') === id)?.[1].default;

// Largura de cada bloco por quebra (4 colunas acima de 860px, 2 abaixo) → widths/sizes do <Image />.
const largo = { widths: [400, 640, 900, 1200], sizes: '(max-width: 860px) calc(100vw - 40px), (max-width: 1400px) 46vw, 600px' };
const estreito = { widths: [300, 450, 640], sizes: '(max-width: 860px) 50vw, (max-width: 1400px) 23vw, 300px' };
const bloco: Record<CategoriaId, { ph: string; alt: string; img: typeof largo }> = {
  // TODO: alt final com a foto real
  bolos: { ph: 'ph--caramelo', img: largo, alt: 'Fatia alta de bolo com frutas vermelhas e calda, num prato de cerâmica sobre mesa de madeira' },
  paes: { ph: 'ph--pista', img: estreito, alt: 'Pão de fôrma fatiado sobre uma tábua de madeira, sob luz quente' },
  fatias: { ph: 'ph--fruta', img: estreito, alt: 'Torta de limão com merengue tostado e uma fatia servida ao lado' },
  brigadeiros: { ph: 'ph--noite', img: estreito, alt: 'Caixa kraft aberta com brigadeiros de cacau, pistache e coco' },
  bento: { ph: 'ph--noite', img: { ...largo, sizes: '(max-width: 860px) 50vw, (max-width: 1400px) 46vw, 600px' }, alt: 'Bento cake branco com vela acesa, numa embalagem aberta' },
};

const vitrine = categorias.map((cat) => {
  const produtos = getProdutosPorCategoria(cat.id);
  const esgotado = produtos.every((p) => !p.disponivel);
  // esgotado: o preço continua visível (menor preço entre todos os produtos da categoria)
  const precos = produtos.filter((p) => esgotado || p.disponivel).flatMap((p) => p.variantes.map((v) => v.preco));
  const minimo = precoMinimo(cat.id) ?? Math.min(...precos);
  return { ...cat, ...bloco[cat.id], foto: fotoDe(cat.id), esgotado, aPartirDe: new Set(precos).size > 1, preco: formatarPreco(minimo) };
});
---

<section class="sec sec--tint" id={secao.id}>
  <div class="wrapx">
    <SectionHeading numero={numero} rotulo={secao.rotulo} titulo={secao.titulo} tituloDestaque={secao.tituloDestaque} />
    <div class="sec-body">
      <p class="lead">Tudo sem glúten e sem leite, feito em pequenas fornadas.</p>

      <div class="bento">
        {vitrine.map((c) => (
          <a
            class:list={['tile', 'cat', !c.foto && ['ph', 'ph-empty', c.ph], c.esgotado && 'is-out']}
            href={`/pedido#${c.id}`}
            style={`grid-area: ${c.id}`}
            data-ph={c.foto ? undefined : `${c.id}.jpg`}
            data-ico={c.id === 'brigadeiros' ? 'doce' : undefined}
            data-rv
          >
            {c.foto && <Image class="foto" src={c.foto} alt={c.alt} widths={c.img.widths} sizes={c.img.sizes} loading="lazy" />}
            {c.esgotado && <span class="tag tag--vidro">Esgotado nesta semana</span>}
            <span class="ov" data-theme="dark">
              <span class="kicker">{c.tipo}</span>
              <h3 class="h4">{c.nome}</h3>
              <span class="preco">{c.aPartirDe && <><small>a partir de</small>{' '}</>}{c.preco}</span>
              <span class="mais"><span class="mais-in"><span class="chamada">{c.chamada}</span><Icon name="solar:arrow-right-linear" /></span></span>
            </span>
          </a>
        ))}
        <div class="tile txt" style="grid-area: mao" data-rv>
          <span class="rabisco"><Doodle name="granulado" /></span>
          <p class="hand">sim, até o brigadeiro é sem leite</p>
        </div>
      </div>

      <a class="link-r ver-tudo" href="/pedido">
        Ver cardápio completo<Icon name="solar:arrow-right-linear" />
        <svg class="risco" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 8.5C18 4 34 10 52 6.5S88 9.5 104 5.8c6-1.2 10-.8 14 .7" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .lead { margin: -1.5rem 0 2.5rem; }

  /* grade por áreas, sem buracos: Bolos 2×2 · Pães 1×2 · Fatias e Brigadeiros 1×1 · Bento e bloco à mão 2×1 */
  .bento {
    --linha: 210px;
    display: grid; gap: 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(var(--linha), auto));
    grid-template-areas: 'bolos bolos paes fatias' 'bolos bolos paes brigadeiros' 'bento bento mao mao';
  }
  @media (max-width: 1023px) { .bento { --linha: 240px; } }
  @media (max-width: 860px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(170px, auto)) auto;
      grid-template-areas: 'bolos bolos' 'paes fatias' 'brigadeiros bento' 'mao mao';
    }
  }

  .tile { position: relative; overflow: hidden; border-radius: var(--r-lg); background: var(--bg-2); }
  .tile.txt { display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; padding: 1.6rem; background: var(--surface); border: 1px solid var(--line); }
  .rabisco { display: block; width: 46px; height: 46px; color: var(--accent); }

  /* bloco de categoria: a foto preenche e a legenda fica embaixo, por cima dela (como no DS). Abaixo de 860px a legenda
     entra no fluxo para a linha crescer se ela precisar; acima, as linhas são fixas e o hover não mexe na grade. */
  .cat { display: flex; flex-direction: column; justify-content: flex-end; }
  .cat:focus-visible { border-radius: var(--r-lg); }
  .cat.ph-empty::after { inset: .75rem .75rem auto auto; }
  .cat :global(.foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 1.2s var(--e-zoom), filter .6s; }
  .cat:hover :global(.foto), .cat:focus-visible :global(.foto) { transform: scale(1.08); }
  .cat.is-out :global(.foto) { filter: grayscale(.85) brightness(.9); }
  .cat .tag { position: absolute; left: 1rem; top: 1rem; z-index: 2; }

  /* legenda sobre foto, sempre no tema escuro, com dois véus atrás do texto (o ::before do bloco fica livre para o .ph):
     .ov::after, de baixo para cima e medido em px, cobre a pilha fixa (tipo, nome, preço) em qualquer tamanho de bloco;
     .ov::before escurece até o topo quando a chamada aparece. */
  .ov { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; gap: .35rem; padding: 1.4rem; color: #FBF3E6; }
  .ov::before, .ov::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ov::after { background: linear-gradient(to top, rgba(20, 13, 10, .9) 0, rgba(20, 13, 10, .8) 110px, rgba(20, 13, 10, 0) 200px); }
  .ov::before { background: linear-gradient(to top, rgba(20, 13, 10, .72) 0, rgba(20, 13, 10, .72) 230px, rgba(20, 13, 10, 0) 340px); }
  .ov .kicker { color: var(--accent-2); }
  .ov .h4 { font-size: clamp(1.15rem, 1.7vw, 1.6rem); color: #FBF3E6; }
  .preco { font-family: var(--serif); font-weight: 500; font-size: 1.2rem; line-height: 1.2; white-space: nowrap; }
  .preco small { font-family: var(--sans); font-size: .75rem; font-weight: 400; letter-spacing: .02em; color: var(--ink-2); }

  /* chamada + seta: visíveis por padrão; só com ponteiro de verdade acima de 860px ficam guardadas e sobem no hover/foco */
  .mais { display: grid; grid-template-rows: 1fr; }
  .mais-in { min-height: 0; overflow: hidden; display: flex; align-items: flex-end; gap: .6rem; }
  .chamada { font-size: .875rem; line-height: 1.5; color: var(--ink-2); max-width: 34ch; }
  .mais-in :global(.icon) { flex: none; font-size: 1.1rem; margin-bottom: .15rem; color: var(--accent-2); }
  @media (hover: hover) and (min-width: 861px) {
    .mais, .ov::before { opacity: 0; transition: opacity .5s; }
    .mais { grid-template-rows: 0fr; transition: grid-template-rows .5s var(--e-out), opacity .5s; }
    .cat:hover .mais, .cat:focus-visible .mais { grid-template-rows: 1fr; opacity: 1; }
    .cat:hover .ov::before, .cat:focus-visible .ov::before { opacity: 1; }
  }
  @media (max-width: 860px) {
    .ov { position: relative; inset: auto; flex-grow: 1; padding: 2.5rem 1rem 1rem; gap: .25rem; }
    .ov::before { display: none; }
    .ov .h4 { font-size: clamp(1.15rem, 4.2vw, 1.6rem); }
    /* a legenda ocupa quase o bloco todo: véu mais alto */
    .ov::after { background: linear-gradient(to top, rgba(20, 13, 10, .92) 0%, rgba(20, 13, 10, .8) 50%, rgba(20, 13, 10, .72) 100%); }
    .chamada { font-size: .8125rem; }
    .cat .tag { left: .75rem; top: .75rem; }
    .tile.txt { flex-direction: row; align-items: center; padding: 1.2rem 1.4rem; }
    .rabisco { flex: none; }
  }

  .ver-tudo { margin-top: 2.5rem; }

  /* movimento reduzido: sem zoom e sem deslocamento; a chamada só aparece (fade), sem empurrar a legenda */
  @media (prefers-reduced-motion: reduce) {
    .cat:hover :global(.foto), .cat:focus-visible :global(.foto) { transform: none; }
    .mais { grid-template-rows: 1fr !important; transition: opacity .5s !important; }
  }
</style>
