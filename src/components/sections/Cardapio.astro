---
// CARDÁPIO. Esqueleto: título e âncora prontos, conteúdo por fazer.
// Referência (design_system2.html · 03 Componentes): cards de produto (.produto com tilt 3D,
// favorito e barra de sacola), cards de sabor que viram (.flip) e cardápio com abas (.carte).
// Produtos vêm de src/data/cardapio.ts (categorias + getProdutosPorCategoria + precoMinimo).
import SectionHeading from '../ui/SectionHeading.astro';
import type { Secao } from '../../data/site';

interface Props { secao: Secao; numero: number }
const { secao, numero } = Astro.props;
---

<section class="sec sec--tint" id={secao.id}>
  <div class="wrapx">
    <SectionHeading numero={numero} rotulo={secao.rotulo} titulo={secao.titulo} tituloDestaque={secao.tituloDestaque} />
    <div class="sec-body">{/* TODO: conteúdo da etapa "Cardapio" */}</div>
  </div>
</section>
