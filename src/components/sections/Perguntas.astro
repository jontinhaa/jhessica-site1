---
// PERGUNTAS · dúvidas frequentes. Esqueleto: título e âncora prontos, conteúdo por fazer.
// Perguntas e respostas devem vir de dados (src/data/), com <details>/<summary> para abrir e fechar.
import SectionHeading from '../ui/SectionHeading.astro';
import type { Secao } from '../../data/site';

interface Props { secao: Secao; numero: number }
const { secao, numero } = Astro.props;
---

<section class="sec" id={secao.id}>
  <div class="wrapx">
    <SectionHeading numero={numero} rotulo={secao.rotulo} titulo={secao.titulo} tituloDestaque={secao.tituloDestaque} />
    <div class="sec-body">{/* TODO: conteúdo da etapa "Perguntas" */}</div>
  </div>
</section>
