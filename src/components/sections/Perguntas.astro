---
// PERGUNTAS · dúvidas frequentes em <details>/<summary> nativos (teclado e toque, sem JS; só uma aberta por vez, pelo
// atributo `name`). Perguntas e respostas vêm de src/data/perguntas.ts, montadas dos dados do site e do cardápio;
// pergunta com pendência da cliente não aparece. Fecha com o convite para o WhatsApp.
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { contato, redes, type Secao } from '../../data/site';
import { perguntas } from '../../data/perguntas';

interface Props { secao: Secao; numero: number }
const { secao, numero } = Astro.props;
---

<section class="sec" id={secao.id}>
  <div class="wrapx">
    <SectionHeading numero={numero} rotulo={secao.rotulo} titulo={secao.titulo} tituloDestaque={secao.tituloDestaque} />
    <div class="faq">
      <div class="lista">
        {perguntas.map((p) => (
          <details name="perguntas" data-rv>
            <summary><span class="q">{p.pergunta}</span><span class="mais" aria-hidden="true"></span></summary>
            <div class="r">{p.resposta.map((par) => <p>{par}</p>)}</div>
          </details>
        ))}
      </div>

      <aside class="duvida surface" data-rv>
        <p class="h4">Ainda ficou dúvida?</p>
        <p class="t-m">Chama no WhatsApp. {contato.atendimento.texto}.</p>
        {redes.whatsapp && (
          <Button variant="linha" href={redes.whatsapp} target="_blank" rel="noopener"><Icon name="simple-icons:whatsapp" />Chamar no WhatsApp</Button>
        )}
      </aside>
    </div>
  </div>
</section>

<style>
  .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .lista { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; min-height: 64px; padding: 1rem 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: var(--r-sm); }
  .q { font-family: var(--serif); font-weight: 300; font-size: clamp(1.15rem, 1.9vw, 1.45rem); line-height: 1.25; }
  summary:hover .q, details[open] .q { color: var(--accent-ink); }
  /* + que vira − (duas barras; a vertical some ao abrir) */
  .mais { position: relative; flex: none; width: 22px; height: 22px; color: var(--accent); }
  .mais::before, .mais::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 1.5px; background: currentColor; translate: -50% -50%; transition: rotate .35s var(--e-out); }
  .mais::after { rotate: 90deg; }
  details[open] .mais::after { rotate: 0deg; }
  .r { display: flex; flex-direction: column; gap: .8rem; padding: 0 2.6rem 1.5rem 0; max-width: 62ch; color: var(--ink-2); line-height: 1.7; }
  .r p { margin: 0; }
  .duvida { display: flex; flex-direction: column; align-items: flex-start; gap: .8rem; padding: 1.6rem; position: sticky; top: calc(var(--nav-h) + 1.5rem); }
  .duvida .h4 { margin: 0; }
  .duvida .t-m { margin: 0 0 .6rem; }

  @media (max-width: 860px) {
    .faq { grid-template-columns: 1fr; }
    .duvida { position: static; }
    .r { padding-right: 0; }
  }
</style>
