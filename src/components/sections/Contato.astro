---
// CONTATO · última dobra, o fechamento da página (DS: .cta-sec + .trail + .circ + .comanda + .carimbo).
//  · título gigante com letras em 3D que sobem uma a uma (como a hero) e um círculo à mão que se desenha em "você";
//  · rastro de doces seguindo o cursor (mouse); no toque, um leque de fotos no fim da seção;
//  · botão principal grande com efeito magnético leve (só mouse) e a seta apontando para ele;
//  · horário, retirada e entrega numa "comanda" (papel com borda em zigue-zague e pontilhado);
//  · carimbo girando e assinatura à mão.
// Tudo vem de src/data/site.ts. SEM mapa e SEM endereço completo: só o bairro. Fotos PROVISÓRIAS do cardápio
// (src/assets/images/cardapio/): trocar quando chegarem as reais. Movimento reduzido: tudo parado na posição final.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Doodle from '../ui/Doodle.astro';
import Carimbo from '../ui/Carimbo.astro';
import { contato, diasDeEntrega, entregaConfirmada, pedido, redes, regrasPedido, type Secao } from '../../data/site';

interface Props { secao: Secao; numero: number }
const { secao, numero } = Astro.props;

const fotosGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/cardapio/*.{jpg,jpeg,png,webp}', { eager: true });
const fotos = Object.values(fotosGlob).map((m) => m.default);

// letras em 3D, agrupadas por palavra (a quebra de linha só acontece entre palavras)
let n = 0;
const letras = (texto: string) => texto.split(' ').map((p) => [...p].map((c) => ({ c, i: n++ })));
// o título vem de `secoes` (site.ts): a 1ª linha é `titulo`; no destaque, a última palavra ganha o círculo à mão
const palavrasDestaque = secao.tituloDestaque.split(' ');
const linha1 = letras(secao.titulo);
const linha2 = letras(palavrasDestaque.slice(0, -1).join(' '));
const voce = letras(palavrasDestaque.at(-1)!);

// o dia da entrega só aparece depois de confirmado (entregaConfirmada)
const comanda = [
  { rotulo: 'Atendimento', valor: contato.atendimento.textoCurto },
  { rotulo: 'Retirada', valor: `${contato.bairroRetirada}, ${contato.cidade}` },
  { rotulo: 'Entrega', valor: entregaConfirmada.confirmado ? `aos ${diasDeEntrega()}` : 'combinada no WhatsApp' },
];
---

<section class="sec sec--tint cta-sec" id={secao.id}>
  <div class="trail" aria-hidden="true">
    {fotos.map((f) => <div class="tp"><Image src={f} alt="" widths={[220, 440]} sizes="170px" loading="lazy" /></div>)}
  </div>

  <div class="carimbo-pos"><Carimbo id="contato" texto={`feito à mão · por encomenda · ${contato.cidade} · `} /></div>

  <div class="wrapx inner">
    <div class="eyebrow-line"><i aria-hidden="true"></i><span>{String(numero).padStart(2, '0')} · {secao.rotulo}</span></div>

    <h2 class="titulo" data-titulo aria-label={`${secao.titulo} ${secao.tituloDestaque}`}>
      <span class="l1" aria-hidden="true">{linha1.map((p, j) => [j ? ' ' : '', <span class="w">{p.map(({ c, i }) => <span class="cm"><span class="ch" style={`--i:${i}`}>{c}</span></span>)}</span>])}</span>
      <em aria-hidden="true">
        {linha2.map((p, j) => [j ? ' ' : '', <span class="w">{p.map(({ c, i }) => <span class="cm"><span class="ch" style={`--i:${i}`}>{c}</span></span>)}</span>])}{linha2.length ? ' ' : ''}
        <span class="circ"><span class="w">{voce[0].map(({ c, i }) => <span class="cm"><span class="ch" style={`--i:${i}`}>{c}</span></span>)}</span><svg viewBox="0 0 200 80" preserveAspectRatio="none"><path pathLength="1" d="M150 12C110 2 40 6 16 26-2 42 22 70 90 72c60 2 102-14 98-36-3-18-38-28-76-26" /></svg></span>
      </em>
    </h2>

    <p class="lead" data-rv>Monte o pedido no site e envie pelo WhatsApp. A Jhessica confirma a data e combina tudo com você.</p>

    <div class="acoes" data-rv>
      <span class="principal" data-magnetico>
        <span class="seta" aria-hidden="true"><Doodle name="seta" /></span>
        <Button href={pedido.href} data-esconde-pilula><Icon name="solar:bag-4-linear" />Montar meu pedido</Button>
      </span>
      {redes.whatsapp && (
        <Button variant="vidro" href={redes.whatsapp} target="_blank" rel="noopener"><Icon name="simple-icons:whatsapp" />Chamar no WhatsApp</Button>
      )}
    </div>

    {redes.instagram && (
      <a class="link-r insta" href={redes.instagram} target="_blank" rel="noopener" data-rv>
        <Icon name="simple-icons:instagram" />Instagram <span class="micro">@{contato.instagram}</span>
      </a>
    )}

    <div class="comanda" data-rv>
      <div class="comanda-top"><span class="kicker">Comanda do ateliê</span><span class="micro">{contato.cidade}</span></div>
      <ul>
        {comanda.map((l) => <li><span>{l.rotulo}</span><i aria-hidden="true"></i><b>{l.valor}</b></li>)}
        {entregaConfirmada.confirmado && <li class="nota"><span>Entrega grátis no bairro {regrasPedido.entrega.gratisNoBairro}</span></li>}
      </ul>
    </div>

    <p class="hand assin" data-rv>Com muito empenho — J.</p>

    <div class="leque" aria-hidden="true">
      {fotos.slice(0, 3).map((f, k) => <div class="foto" style={`--k:${k}`}><Image src={f} alt="" widths={[200, 400]} sizes="120px" loading="lazy" /></div>)}
    </div>
  </div>
</section>

<style>
  .cta-sec { min-height: 100svh; display: grid; place-items: center; overflow: clip; text-align: center; }
  .inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 1.6rem; }
  .inner .eyebrow-line { justify-content: center; }

  /* título: letras em 3D (como a hero) + círculo à mão em "você", ambos disparados quando a seção entra na tela */
  .titulo { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(2.8rem, 7.4vw, 6.4rem); line-height: 1.02; letter-spacing: -.02em; text-wrap: balance; }
  .titulo .l1 { display: block; }
  .titulo em { display: block; font-style: italic; color: var(--accent); }
  .w { display: inline-block; white-space: nowrap; }
  .cm { display: inline-block; overflow: hidden; vertical-align: bottom; padding: .18em .08em .35em; margin: -.18em -.08em -.35em; perspective: 500px; }
  .ch { display: inline-block; transform-origin: bottom center; }
  :global(.rv-on) .ch { transform: translateY(110%) translateZ(-60px) rotateX(-65deg); opacity: 0; filter: blur(12px);
    transition: transform 1.3s var(--e-out), opacity .9s ease, filter 1.2s ease; transition-delay: calc(var(--i) * 26ms); }
  :global(.rv-on) .titulo.on .ch { transform: none; opacity: 1; filter: none; }
  .circ { position: relative; display: inline-block; white-space: nowrap; margin-left: .14em; }
  .circ svg { position: absolute; left: -12%; top: -24%; width: 124%; height: 150%; overflow: visible; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; pointer-events: none;
    stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .9s var(--e-flip) 1.3s; }
  .titulo.on .circ svg { stroke-dashoffset: 0; }
  .cta-sec .lead { max-width: 40ch; margin: 0; }

  /* chamada principal, maior; a seta aponta para ela */
  .acoes { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem; }
  .principal { position: relative; display: inline-flex; will-change: translate; transition: translate .5s var(--e-out); }
  .principal :global(.btn) { --h: 64px; padding-inline: 2.6rem; }
  .seta { position: absolute; right: calc(100% + .4rem); top: -3rem; width: 72px; color: var(--accent); }
  .insta { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; }
  .insta .micro { margin-left: .2rem; }

  /* comanda (DS · .comanda): papel com borda de baixo em zigue-zague e pontilhado entre o nome e o valor */
  .comanda { width: min(100%, 440px); margin-top: .8rem; padding: 1.6rem 1.5rem 2.4rem; text-align: left; background: var(--surface-2); border-radius: var(--r-md) var(--r-md) 0 0; /* sem sombra: a máscara do zigue-zague a cortaria */
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 18px 100%; mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 18px 100%; }
  .comanda-top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: .9rem; }
  .comanda ul { margin: 0; padding: 0; list-style: none; }
  .comanda li { display: flex; align-items: baseline; gap: .6rem; padding: .45rem 0; font-size: .9rem; color: var(--ink-2); }
  .comanda li i { flex: 1; border-bottom: 1px dotted var(--line-2); }
  .comanda li b { font-weight: 500; color: var(--ink); text-align: right; }
  .comanda li.nota { padding-top: .8rem; font-size: .8rem; color: var(--muted); }
  .assin { margin: 0; font-size: 2rem; color: var(--accent-ink); }

  /* carimbo girando no canto */
  .carimbo-pos { position: absolute; top: 12%; right: 6%; z-index: 1; --carimbo-bg: transparent; }

  /* rastro de doces (DS · .trail): fotos nascem sob o cursor e somem; só com mouse e movimento permitido */
  .trail { position: absolute; inset: 0; z-index: 1; overflow: clip; pointer-events: none; display: none; }
  .tp { position: absolute; left: 0; top: 0; width: clamp(110px, 11vw, 170px); aspect-ratio: 4 / 5; border-radius: var(--r-sm); overflow: hidden; pointer-events: none; box-shadow: var(--shadow-2); opacity: 0; }
  .tp :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tp::after { content: ''; position: absolute; inset: 0; background: rgba(var(--bg-rgb), .3); } /* véu: o texto continua legível quando uma foto passa por baixo */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .trail { display: block; }
    .cta-sec { cursor: crosshair; }
    .cta-sec :is(a, button) { cursor: pointer; }
  }

  /* leque de fotos (toque): três fotos sobrepostas, balançando devagar */
  .leque { display: none; position: relative; width: 100%; height: 190px; margin-top: .6rem; }
  .leque .foto { position: absolute; left: 50%; top: 0; width: 120px; aspect-ratio: 4 / 5; border-radius: var(--r-sm); overflow: hidden; box-shadow: var(--shadow-2);
    translate: calc(-50% + (var(--k) - 1) * 84px) 0; rotate: calc((var(--k) - 1) * 9deg); transform-origin: 50% 100%;
    animation: contato-balanca 5.5s ease-in-out infinite alternate; animation-delay: calc(var(--k) * -1.4s); }
  .leque .foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @keyframes contato-balanca { from { transform: translateY(0) rotate(-2deg); } to { transform: translateY(-10px) rotate(2deg); } }
  @media (hover: none), (pointer: coarse) { .leque { display: block; } }

  @media (max-width: 1023px) {
    .carimbo-pos { position: static; margin-bottom: -.4rem; z-index: 2; }
    .cta-sec { grid-template-rows: auto auto; place-content: center; }
  }
  @media (max-width: 860px) { .seta { display: none; } } /* com os botões rentes à borda, a seta sairia da tela */
  @media (max-width: 640px) {
    .acoes { flex-direction: column; align-items: stretch; width: 100%; }
    .principal { display: flex; }
    .principal :global(.btn), .acoes > :global(.btn) { width: 100%; }
    .principal :global(.btn) { padding-inline: 1.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.rv-on) .ch { transform: none; opacity: 1; filter: none; transition: none; }
    .circ svg { stroke-dashoffset: 0; transition: none; }
    .leque .foto { animation: none; }
  }
</style>

<script>
  const sec = document.getElementById('contato');
  if (sec) {
    const titulo = sec.querySelector<HTMLElement>('[data-titulo]')!;
    const reduzir = matchMedia('(prefers-reduced-motion: reduce)');
    const fino = matchMedia('(hover: hover) and (pointer: fine)');

    // letras e círculo disparam uma vez, quando o título entra na tela
    new IntersectionObserver(([e], io) => { if (e.isIntersecting) { titulo.classList.add('on'); io.disconnect(); } }, { threshold: .35 }).observe(titulo);

    // rastro de doces (DS · Follow image-trail): a cada ~95px do cursor, uma foto nasce, gira e cai um pouco
    if (fino.matches && !reduzir.matches) {
      const fotos = [...sec.querySelectorAll<HTMLElement>('.tp')];
      let i = 0, lx = -999, ly = -999, z = 1;
      if (fotos.length) {
        sec.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse' || reduzir.matches) return; // caneta, toque e movimento reduzido não deixam rastro
          const r = sec.getBoundingClientRect(), px = e.clientX - r.left, py = e.clientY - r.top;
          if (Math.hypot(px - lx, py - ly) < 95) return;
          lx = px; ly = py;
          const el = fotos[i++ % fotos.length], rot = Math.random() * 16 - 8;
          el.style.zIndex = String(++z);
          el.getAnimations().forEach((a) => a.cancel());
          const base = `translate(${px}px, ${py}px) translate(-50%, -50%) `;
          el.animate([
            { transform: `${base}scale(.5) rotate(${rot}deg)`, opacity: 0 },
            { transform: `${base}scale(1) rotate(${rot}deg)`, opacity: .8, offset: .16 },
            { transform: `translate(${px}px, ${py + 50}px) translate(-50%, -50%) scale(.86) rotate(${rot * 1.8}deg)`, opacity: 0 },
          ], { duration: 1400, easing: 'cubic-bezier(.2, .8, .2, 1)', fill: 'forwards' });
        });
      }

      // botão principal "magnético": acompanha o cursor de leve quando ele chega perto
      const imas = [...sec.querySelectorAll<HTMLElement>('[data-magnetico]')];
      const solta = () => imas.forEach((m) => { m.style.translate = ''; });
      sec.addEventListener('pointermove', (e) => imas.forEach((m) => {
        if (e.pointerType !== 'mouse' || reduzir.matches) return;
        const b = m.getBoundingClientRect(), dx = e.clientX - (b.left + b.width / 2), dy = e.clientY - (b.top + b.height / 2);
        if (Math.hypot(dx, dy) > 190) { m.style.translate = ''; return; }
        const f = (v: number) => Math.max(-12, Math.min(12, v * .22));
        m.style.translate = `${f(dx)}px ${f(dy)}px`;
      }));
      sec.addEventListener('pointerleave', solta);
    }
  }
</script>
