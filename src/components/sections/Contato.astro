---
// CONTATO · fechamento. Esqueleto: título e âncora prontos, conteúdo por fazer.
// Referência (design_system2.html · fim): CTA (Asagiri .cta-sec) com rastro de fotos seguindo o
// cursor (Follow image-trail) + linhas de contato com .well. Contato e redes em src/data/site.ts.
import SectionHeading from '../ui/SectionHeading.astro';
import type { Secao } from '../../data/site';

interface Props { secao: Secao; numero: number }
const { secao, numero } = Astro.props;
---

<section class="sec sec--tint" id={secao.id}>
  <div class="wrapx">
    <SectionHeading numero={numero} rotulo={secao.rotulo} titulo={secao.titulo} tituloDestaque={secao.tituloDestaque} center />
    <div class="sec-body">{/* TODO: conteúdo da etapa "Contato" */}</div>
  </div>
</section>
