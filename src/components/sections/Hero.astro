---
// HERO · vídeo em loop no lugar da foto, sob os véus da Nereo (grade 7/5, cards de vidro com tilt),
// letras em 3D da Clarix e açúcar em canvas da Asagiri. Logo abaixo, a faixa corrente (Sable).
// Referência: templates/design_system.astro · "0 · HERO" e "faixa corrente".
// Movimento sem GSAP: entrada em CSS e parallax por scroll-driven animations (sem suporte, fica parado).
// Vídeos em public/videos, gerados de final_4k60.mp4: hero-1080.mp4 (≥768px) e hero-retrato.mp4 (9:16).
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Doodle from '../ui/Doodle.astro';
import { scallop } from '../ui/mark';

// Título partido em letras já no build: nada pisca antes do JS e a entrada 3D roda só com CSS.
let n = 0;
const letters = (text: string) => text.split(' ').map((w) => [...w].map((c) => ({ c, i: n++ })));
const l1 = letters('Cozinha');
const l2 = letters('saudável.');

// Faixa corrente: cartaz (Archivo) + itálico (Newsreader). Quatro cópias para o laço não abrir buraco em tela larga.
const faixa = [
  ['Sem glúten', 'sem leite'],
  ['Bolos, pães & doces', 'feitos à mão'],
  ['Bons hábitos', 'com muito sabor'],
];
---

<section class="hero" id="top">
  <div class="amb a" aria-hidden="true"></div>
  <div class="amb b" aria-hidden="true"></div>
  <div class="hero-media" aria-hidden="true">
    <div class="hero-pic">
      <video muted loop playsinline preload="none" poster="/videos/hero-poster.webp">
        <source src="/videos/hero-1080.mp4" type="video/mp4" media="(min-width: 768px)" />
        <source src="/videos/hero-retrato.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="scrim-x"></div>
    <div class="scrim-r"></div>
  </div>
  <div class="scrim-y" aria-hidden="true"></div>
  <canvas class="sugar" aria-hidden="true"></canvas>

  <div class="wrapx hero-grid">
    <div class="hero-copy">
      <div class="eyebrow-line" data-hero style="--i:0"><i aria-hidden="true"></i><span>Confeitaria &amp; cozinha artesanal</span></div>
      <h1 class="h1" aria-label="Jhessica em Cozinha Saudável">
        <span class="sig" aria-hidden="true">Jhessica em</span>
        <span class="l1" aria-hidden="true">{l1.map((w, j) => [j ? ' ' : '', <span class="w">{w.map(({ c, i }) => <span class="cm"><span class="ch" style={`--i:${i}`}>{c}</span></span>)}</span>])}</span>
        <em aria-hidden="true">{l2.map((w, j) => [j ? ' ' : '', <span class="w">{w.map(({ c, i }) => <span class="cm"><span class="ch" style={`--i:${i}`}>{c}</span></span>)}</span>])}</em>
      </h1>
      <div class="ornament" data-hero style="--i:1" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 14 14"><g fill="currentColor"><circle cx="10.6" cy="7" r="2.1" /><circle cx="8.8" cy="10.1" r="2.1" /><circle cx="5.2" cy="10.1" r="2.1" /><circle cx="3.4" cy="7" r="2.1" /><circle cx="5.2" cy="3.9" r="2.1" /><circle cx="8.8" cy="3.9" r="2.1" /></g><circle cx="7" cy="7" r="1.3" style="fill: var(--bg)" /></svg>
        <i></i>
      </div>
      <p class="lead" data-hero style="--i:2">Bolos, pães e doces sem glúten e sem leite, feitos à mão em Marabá.</p>
      <div class="hero-cta" data-hero style="--i:3">
        <Button href="/pedido"><Icon name="solar:bag-4-linear" />Encomendar</Button>
        <Button variant="vidro" href="#cardapio"><Icon name="solar:list-heart-minimalistic-linear" />Ver cardápio</Button>
      </div>
      <ul class="hero-badges" data-hero style="--i:4">
        <li><Icon name="solar:hand-heart-linear" /><span>Feito à mão</span></li>
        <li><Icon name="solar:calendar-linear" /><span>Pedidos com 2 dias de antecedência</span></li>
        <li><Icon name="solar:delivery-linear" /><span>Entrega aos domingos</span></li>
      </ul>
    </div>

    <div class="hero-cards">
      <div class="glass glass-card hc" data-tilt style="--i:0">
        <div class="hc-row">
          <div>
            <p class="hc-big">Bolos, pães <em>&amp; doces</em></p>
            <p class="micro">Do café da manhã à sobremesa</p>
          </div>
          <div class="well"><Icon name="solar:chef-hat-linear" /></div>
        </div>
        <i class="glare" aria-hidden="true"></i>
      </div>
      <div class="glass glass-card hc" data-tilt style="--i:1">
        <div class="hc-row">
          <div>
            <span class="kicker">Pensado para</span>
            <p class="hc-mid">Restrições alimentares</p>
            <p class="micro">Sem deixar ninguém de fora</p>
          </div>
          <div class="well"><Icon name="solar:hand-heart-linear" /></div>
        </div>
        <i class="glare" aria-hidden="true"></i>
      </div>
      <div class="glass glass-card hc" data-tilt style="--i:2">
        <div class="hc-row hc-row--top">
          <div class="well well--sm"><Icon name="solar:cup-hot-linear" /></div>
          <div>
            <span class="kicker">E para quem deseja</span>
            <p class="hc-mid">Cultivar bons hábitos</p>
            <p class="t-m">Opções para o dia a dia e para as datas especiais, sem abrir mão do sabor.</p>
          </div>
        </div>
        <i class="glare" aria-hidden="true"></i>
      </div>
      <!-- anotação da Nereo: no fluxo da coluna, aponta para o vídeo sem nunca cobrir os selos -->
      <p class="hero-note" style="--i:3" aria-hidden="true"><Doodle name="seta" /><span class="hand">sim, tudo isso é<br />sem glúten e sem leite</span></p>
    </div>
  </div>

  <p class="hero-v">Fechados aos sábados</p>
  <div class="scroll-cue" data-hero style="--i:5" aria-hidden="true"><span class="ln"></span>Role devagar</div>
  <!-- WCAG 2.2.2: vídeo, açúcar e faixa param juntos -->
  <button class="hero-pause" type="button" aria-label="Pausar vídeo">
    <Icon name="solar:pause-linear" class="i-pause" />
    <Icon name="solar:play-linear" class="i-play" />
  </button>
</section>

<div class="ticker">
  <svg class="sprite" aria-hidden="true">
    <symbol id="mk" viewBox="0 0 80 80">
      <path d={scallop} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <circle cx="40" cy="40" r="23" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2.5 3.2" opacity=".7" />
      <text x="40.5" y="51" text-anchor="middle" style="font-family: var(--serif)" font-style="italic" font-size="31" fill="currentColor">J</text>
    </symbol>
  </svg>
  <div class="run">
    {[0, 1, 2, 3].map((k) => (
      <div class="tk" aria-hidden={k ? 'true' : undefined}>
        {faixa.map(([a, b]) => [
          <span>{a}</span>,
          <svg aria-hidden="true"><use href="#mk" /></svg>,
          <em>{b}</em>,
          <svg aria-hidden="true"><use href="#mk" /></svg>,
        ])}
      </div>
    ))}
  </div>
</div>

<style>
  /* ---------- palco: vídeo sob os véus ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; isolation: isolate; padding: calc(var(--nav-h) + 2rem) 0 5rem; }
  .amb { position: absolute; z-index: 1; border-radius: 50%; filter: blur(100px); pointer-events: none; }
  .amb.a { width: 520px; height: 520px; top: 16%; right: 8%; background: rgba(var(--accent-rgb), .12); }
  .amb.b { width: 420px; height: 420px; bottom: 6%; left: 4%; background: var(--glow-b); }
  .hero-media { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .hero-pic { position: absolute; inset: -10% 0; }
  video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 74% 50%; scale: 1.05; filter: brightness(var(--hero-dim)) contrast(1.04); }
  .scrim-x, .scrim-r { position: absolute; inset: 0; }
  .scrim-x { background: linear-gradient(90deg, var(--bg) 0%, var(--bg) 27%, rgba(var(--bg-rgb), .88) 40%, rgba(var(--bg-rgb), .46) 56%, rgba(var(--bg-rgb), .14) 74%, rgba(var(--bg-rgb), .06) 100%); }
  .scrim-r { background: radial-gradient(circle at 74% 50%, rgba(var(--accent-rgb), .09) 0%, rgba(var(--bg-rgb), .16) 42%, rgba(var(--bg-rgb), .74) 100%); }
  .scrim-y { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(to top, var(--bg) 0%, rgba(var(--bg-rgb), 0) 24%, rgba(var(--bg-rgb), 0) 72%, rgba(var(--bg-rgb), .72) 100%); }
  .sugar { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; pointer-events: none; }

  /* ---------- grade 7/5 ---------- */
  .hero-grid { position: relative; z-index: 3; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 3rem; align-items: center; }
  .hero-copy { grid-column: span 7; display: flex; flex-direction: column; align-items: flex-start; gap: 2rem; }
  .hero-copy .lead { max-width: 540px; }
  .sig { display: block; width: fit-content; margin: 0 0 .1em .04em; font-family: var(--hand); font-size: clamp(1.75rem, 2.4vw, 2.3rem); font-weight: 400; font-style: normal; line-height: 1.2; letter-spacing: .01em; text-transform: none; color: var(--accent); rotate: -4deg; transform-origin: 0 100%; }
  /* letras em 3D (Clarix .char-mask > .hero-char); a máscara sobra para o acento e o itálico */
  .w { display: inline-block; white-space: nowrap; }
  .cm { display: inline-block; overflow: hidden; vertical-align: bottom; padding: .18em .08em .35em; margin: -.18em -.08em -.35em; perspective: 500px; }
  .ch { display: inline-block; transform-origin: bottom center; }
  .ornament { display: flex; align-items: center; gap: .7rem; width: 10rem; }
  .ornament i { flex: 1; height: 1px; background: var(--line-2); }
  .ornament svg { width: 14px; height: 14px; flex: none; color: var(--accent); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; padding-top: .5rem; }
  .hero-badges { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.35fr) minmax(0, 1fr); gap: 1.5rem; width: 100%; max-width: 680px; padding-top: 2.4rem; border-top: 1px solid var(--line-2); }
  .hero-badges li { display: flex; align-items: center; gap: .75rem; font-size: .75rem; font-weight: 500; letter-spacing: .12em; line-height: 1.4; text-transform: uppercase; color: var(--ink-2); }
  .hero-badges li + li { padding-left: 1.2rem; border-left: 1px solid var(--line-2); }
  .hero-badges :global(.icon) { font-size: 20px; color: var(--accent); }

  /* ---------- cards de vidro ---------- */
  .hero-cards { grid-column: span 5; display: flex; flex-direction: column; align-items: flex-end; gap: 1.3rem; }
  /* vidro denso (o mesmo do aviso flutuante): o vidro de 4% só funciona sobre foto escura e parada */
  .hc { width: 100%; max-width: 350px; background: var(--glass-strong); transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); }
  .hc-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .hc-row--top { align-items: flex-start; justify-content: flex-start; }
  .hc-row--top .well { margin-top: .2rem; }
  .hc-big { font-family: var(--serif); font-size: 2rem; font-weight: 300; line-height: 1.1; letter-spacing: .02em; }
  .hc-big em { display: block; font-style: italic; color: var(--accent); }
  .hc-mid { margin-top: .3rem; font-family: var(--serif); font-size: 1.35rem; font-weight: 300; line-height: 1.2; }
  /* rótulos em caixa alta: mínimo de 12px (acessibilidade) */
  .hero-copy .eyebrow-line span, .hc .kicker, .hc .micro { font-size: .75rem; }
  /* contraste ≥ 4.5 sobre o vídeo em todas as cenas: caramelo puxado para a tinta, cinza trocado pelo tom de texto */
  .hc .kicker, .hero-copy .eyebrow-line span { color: color-mix(in srgb, var(--accent-ink) 80%, var(--ink)); }
  .hc .micro { color: var(--ink-2); }
  .hc .micro { margin-top: .5rem; }
  .hc .t-m { margin-top: .35rem; font-size: .78rem; }
  .well--sm { width: 40px; height: 40px; font-size: 16px; background: none; }
  .glare { position: absolute; inset: 0; z-index: 3; border-radius: inherit; pointer-events: none; opacity: var(--go, 0); background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgba(255, 255, 255, .32), rgba(255, 255, 255, 0) 55%); mix-blend-mode: soft-light; transition: opacity .5s; }

  /* ---------- margens: texto vertical, anotação, "role devagar" e pausa ---------- */
  /* texto vertical da Nereo em pílula de vidro: o vídeo troca de cena (caixa branca, forma escura) e o aviso segue legível */
  .hero-v { position: absolute; top: 50%; right: calc(var(--pad) * .3); z-index: 3; transform: translateY(-50%); writing-mode: vertical-rl; padding: 1.1rem .5rem calc(1.1rem - .32em); border-radius: var(--r-pill); border: 1px solid var(--glass-line); background: var(--glass-strong); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); font-family: var(--serif); font-size: .95rem; font-style: italic; line-height: 1; letter-spacing: .32em; color: var(--ink-2); }
  /* brilho na cor do fundo: a anotação cai sobre o pão ou a caixa branca em algumas cenas */
  .hero-note { width: 100%; max-width: 350px; display: flex; align-items: flex-start; gap: .2rem; margin-top: .2rem; transform: rotate(-4deg); text-shadow: 0 0 10px rgba(var(--bg-rgb), .9), 0 0 3px rgba(var(--bg-rgb), .9); }
  .hero-note :global(.doodle) { width: 56px; height: 42px; flex: none; margin-top: -.9rem; color: var(--accent); scale: -1 -1; filter: drop-shadow(0 0 5px rgba(var(--bg-rgb), .9)); }
  .scroll-cue { position: absolute; left: max(var(--pad), calc((100vw - var(--max)) / 2 + var(--pad))); bottom: 2rem; z-index: 3; display: flex; align-items: center; gap: .8rem; font-size: .75rem; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: var(--muted); }
  .ln { position: relative; width: 46px; height: 1px; overflow: hidden; background: var(--line-2); }
  .ln::after { content: ''; position: absolute; inset: 0; width: 40%; background: var(--accent); animation: run 2.4s ease-in-out infinite; }
  .hero-pause { position: absolute; right: max(var(--pad), calc((100vw - var(--max)) / 2 + var(--pad))); bottom: 1.1rem; z-index: 3; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line-2); font-size: 16px; color: var(--ink-2); background: var(--glass); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); transition: color .3s, border-color .3s, transform .4s var(--e-out); }
  .hero-pause:hover { color: var(--accent); border-color: var(--accent); transform: rotate(-8deg); }
  .hero.is-paused .hero-pause :global(.i-pause), .hero:not(.is-paused) .hero-pause :global(.i-play) { display: none; }

  /* ---------- faixa corrente (Sable .ann) ---------- */
  .ticker { position: relative; overflow: hidden; padding: 1.15rem 0; border-block: 1px solid var(--line); background: rgba(var(--bg-rgb), .55); }
  .sprite { position: absolute; width: 0; height: 0; }
  .run { display: flex; width: max-content; animation: tick 42s linear infinite; }
  .ticker:hover .run { animation-play-state: paused; }
  .tk { display: flex; align-items: center; gap: 2.2rem; padding-right: 2.2rem; white-space: nowrap; }
  .tk span { font-family: var(--poster); font-size: clamp(1.7rem, 3.4vw, 2.7rem); font-stretch: 62%; font-weight: 800; line-height: 1; letter-spacing: -.005em; text-transform: uppercase; }
  .tk em { font-family: var(--serif); font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-style: italic; font-weight: 400; line-height: 1; color: var(--accent); }
  .tk svg { width: 22px; height: 22px; flex: none; color: var(--accent); animation: spin 9s linear infinite; }

  .is-paused :global(*), .is-paused :global(*::after) { animation-play-state: paused !important; }

  @keyframes run { from { transform: translateX(-100%); } to { transform: translateX(280%); } }
  @keyframes tick { to { transform: translateX(-25%); } }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ---------- entrada (o forno abre): letras 3D, assinatura escrita, blocos sobem, vidros desembaçam ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .ch { animation: ch-rise 1.5s var(--e-out) backwards, ch-blur 1.4s ease backwards, ch-fade 1.1s ease backwards; animation-delay: calc(var(--i) * 28ms); }
    .sig { animation: write 1.3s var(--e-flip) .15s backwards; }
    [data-hero] { animation: rise 1s var(--e-out) backwards; animation-delay: calc(.45s + var(--i) * 90ms); }
    .hc, .hero-note { animation: card-in 1.1s var(--e-out) backwards; animation-delay: calc(.75s + var(--i) * 100ms); }
    .hero-v { animation: rise-v 1.6s var(--e-soft) .5s backwards; }
    .hero-pic { animation: settle 2.6s var(--e-soft) backwards; }

    /* parallax (Asagiri): a foto desce 12% e o texto sobe e esmaece enquanto a hero sai da tela */
    @supports (animation-timeline: view()) {
      .hero { view-timeline: --hero block; view-timeline-inset: 0; }
      .hero-pic { animation: settle 2.6s var(--e-soft) backwards, drift auto linear both; animation-timeline: auto, --hero; animation-range: normal, contain 0% cover 100%; }
      .hero-grid { animation: lift auto linear both; animation-timeline: --hero; animation-range: contain 0% cover 100%; }
      /* esmaece a coluna e cada card, não a grade: opacidade no pai apagaria o desfoque do vidro */
      .hero-copy { animation: fade auto linear both; animation-timeline: --hero; animation-range: contain 0% cover 100%; }
      .hc, .hero-note { animation: fade auto linear both, card-in 1.1s var(--e-out) backwards; animation-timeline: --hero, auto; animation-range: contain 0% cover 100%, normal; animation-delay: 0s, calc(.75s + var(--i) * 100ms); }
    }
  }
  @keyframes ch-rise { from { transform: translateY(110%) translateZ(-60px) rotateX(-65deg); } }
  @keyframes ch-blur { from { filter: blur(12px); } }
  @keyframes ch-fade { from { opacity: 0; } }
  @keyframes write { from { clip-path: inset(-30% 100% -40% -10%); } to { clip-path: inset(-30% -10% -40% -10%); } }
  @keyframes rise { from { translate: 0 24px; opacity: 0; } }
  @keyframes card-in { from { translate: 0 36px; opacity: 0; filter: blur(8px); } }
  @keyframes rise-v { from { translate: 0 70px; opacity: 0; } }
  @keyframes settle { from { scale: 1.14; } }
  @keyframes drift { to { translate: 0 12%; } }
  @keyframes lift { to { translate: 0 -70px; } }
  @keyframes fade { to { opacity: .25; } }

  /* ---------- responsivo ---------- */
  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero-copy, .hero-cards { grid-column: 1 / -1; }
    .hero-cards { flex-direction: row; align-items: stretch; overflow-x: auto; padding-bottom: .5rem; scroll-snap-type: x mandatory; }
    .hc { flex: 0 0 min(320px, 82vw); scroll-snap-align: start; }
    .hero-note { display: none; }
    .scrim-x { background: linear-gradient(90deg, var(--bg) 0%, rgba(var(--bg-rgb), .9) 45%, rgba(var(--bg-rgb), .55) 100%); }
    /* o aviso deita e ocupa o lugar do "role devagar": aqui a hero passa da altura da tela e a dica já vem rolada */
    .scroll-cue { display: none; }
    .hero-v { top: auto; right: auto; bottom: 1.1rem; left: var(--pad); transform: none; writing-mode: horizontal-tb; padding: .6rem calc(1.1rem - .32em) .6rem 1.1rem; font-size: .9rem; }
  }
  /* celular: selo, título, subtítulo, botões e selos na primeira tela. Cards, anotação, aviso vertical,
     ornamento e "role devagar" saem (repetem o subtítulo; o aviso de sábado vai para "Como pedir" e o rodapé). */
  @media (max-width: 768px) {
    .hero-cards, .hero-v, .ornament, .scroll-cue { display: none; }
    /* o texto ocupa a tela toda: véu mais firme (contraste ≥ 4.5 em todas as cenas); no dia o creme segura o cacau */
    .scrim-x { background: linear-gradient(90deg, var(--bg) 0%, rgba(var(--bg-rgb), .9) 45%, rgba(var(--bg-rgb), .66) 100%); }
    :global([data-theme='light']) .scrim-x { background: linear-gradient(90deg, var(--bg) 0%, rgba(var(--bg-rgb), .93) 55%, rgba(var(--bg-rgb), .86) 100%); }
    .hero-copy { gap: 1.5rem; }
    .h1 { font-size: clamp(2.4rem, 12.5vw, 3.4rem); }
    .hero-cta { flex-direction: column; gap: 12px; width: 100%; padding-top: 0; }
    .hero-cta :global(.btn) { width: 100%; min-height: 48px; }
    .hero-badges { grid-template-columns: minmax(0, 1fr); gap: .8rem; padding-top: 1.4rem; }
    .hero-badges li + li { padding-left: 0; border-left: 0; }
  }
</style>

<script>
  // Vídeo, açúcar e tilt da hero. O vídeo só baixa quando vai tocar (preload="none"):
  // com movimento reduzido ou economia de dados a hero começa pausada e o botão retoma.
  const hero = document.getElementById('top')!;
  const ticker = document.querySelector<HTMLElement>('.ticker')!;
  const video = hero.querySelector('video')!;
  const btn = hero.querySelector<HTMLButtonElement>('.hero-pause')!;
  const cv = hero.querySelector('canvas')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  let paused = reduced || saveData;
  let visible = true;

  // ---------- poeira de açúcar (o "vapor" da Asagiri, virado açúcar de confeiteiro) ----------
  const sugar = (() => {
    type Grain = { x: number; y: number; r: number; vy: number; ph: number; sw: number; a: number };
    const ctx = cv.getContext('2d')!;
    const DPR = Math.min(2, devicePixelRatio || 1);
    let W = 0, H = 0, grains: Grain[] = [], raf = 0, last = 0, mx = -1e4, my = -1e4, rgb = '255,255,255';
    const grain = (anywhere: boolean): Grain => ({
      x: Math.random() * W, y: anywhere ? Math.random() * H : -12, r: (.45 + Math.random() * 1.6) * DPR,
      vy: (.12 + Math.random() * .4) * DPR, ph: Math.random() * 6.28, sw: .2 + Math.random() * .6, a: .22 + Math.random() * .6,
    });
    const readColor = () => { rgb = getComputedStyle(document.documentElement).getPropertyValue('--sugar').trim() || rgb; };
    function size() {
      const r = cv.getBoundingClientRect(), w = Math.max(2, Math.round(r.width * DPR)), h = Math.max(2, Math.round(r.height * DPR));
      if (w === W && h === H) return; // barra do navegador no celular: mesmo tamanho, nada a refazer
      W = cv.width = w; H = cv.height = h;
      grains = Array.from({ length: Math.min(120, Math.round(r.width * r.height / 13000)) }, () => grain(true));
    }
    function frame(t: number) {
      raf = requestAnimationFrame(frame);
      if (t - last < 33) return; // ~30 fps bastam para pó
      last = t;
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = `rgb(${rgb})`;
      const R = 110 * DPR;
      grains.forEach((p, i) => {
        p.y += p.vy;
        p.x += Math.sin(t * .0006 + p.ph) * p.sw * DPR * .45;
        const dx = p.x - mx, dy = p.y - my, d2 = dx * dx + dy * dy;
        if (d2 < R * R) { const d = Math.sqrt(d2) || 1, f = (1 - d / R) * 2.4 * DPR; p.x += dx / d * f; p.y += dy / d * f; }
        if (p.y > H + 12 || p.x < -20 || p.x > W + 20) grains[i] = grain(false);
        ctx.globalAlpha = p.a;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.283); ctx.fill();
      });
      ctx.globalAlpha = 1;
    }
    readColor(); size();
    addEventListener('resize', size);
    new MutationObserver(readColor).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    hero.addEventListener('pointermove', (e) => { const r = cv.getBoundingClientRect(); mx = (e.clientX - r.left) * DPR; my = (e.clientY - r.top) * DPR; });
    hero.addEventListener('pointerleave', () => { mx = my = -1e4; });
    return (on: boolean) => {
      if (on && !raf) raf = requestAnimationFrame(frame);
      if (!on) { cancelAnimationFrame(raf); raf = 0; }
    };
  })();

  // ---------- vídeo, açúcar e faixa: tocam juntos, param juntos, e param fora da tela ----------
  function sync() {
    const on = !paused && visible;
    if (on) video.play().catch(() => {}); // modo economia do iOS recusa: fica o pôster
    else video.pause();
    sugar(on);
    hero.classList.toggle('is-paused', paused);
    ticker.classList.toggle('is-paused', paused);
    btn.setAttribute('aria-label', paused ? 'Reproduzir vídeo' : 'Pausar vídeo');
  }
  btn.addEventListener('click', () => { paused = !paused; sync(); });
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(hero);

  // ---------- tilt 3D com reflexo nos cards de vidro (só com mouse) ----------
  if (!reduced && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    hero.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      const s = { rx: 0, ry: 0, gx: 50, gy: 50, go: 0 }, t = { ...s }, keys = Object.keys(s) as (keyof typeof s)[];
      let raf = 0;
      const loop = () => {
        let busy = false;
        keys.forEach((k) => { s[k] += (t[k] - s[k]) * .12; if (Math.abs(t[k] - s[k]) > .02) busy = true; });
        el.style.setProperty('--rx', `${s.rx.toFixed(2)}deg`);
        el.style.setProperty('--ry', `${s.ry.toFixed(2)}deg`);
        el.style.setProperty('--gx', `${s.gx.toFixed(1)}%`);
        el.style.setProperty('--gy', `${s.gy.toFixed(1)}%`);
        el.style.setProperty('--go', s.go.toFixed(3));
        raf = busy ? requestAnimationFrame(loop) : 0;
      };
      const kick = () => { raf ||= requestAnimationFrame(loop); };
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect(), nx = (e.clientX - r.left) / r.width * 2 - 1, ny = (e.clientY - r.top) / r.height * 2 - 1;
        Object.assign(t, { rx: -ny * 7, ry: nx * 7, gx: (nx + 1) * 50, gy: (ny + 1) * 50, go: 1 });
        kick();
      });
      el.addEventListener('pointerleave', () => { Object.assign(t, { rx: 0, ry: 0, go: 0 }); kick(); });
    });
  }
</script>
