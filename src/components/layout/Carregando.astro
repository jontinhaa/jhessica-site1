---
// Tela de carregamento · "o forno preaquecendo" (design system, seção 04 · loader): a forminha se desenha, o odômetro
// sobe até 180 °C conforme as fontes e o pôster da hero carregam, e a tela some com "no ponto · pode servir".
// Só na home e uma vez por sessão: o BaseLayout marca <html data-forno> e o script inline do <head> põe
// html.carregando antes do primeiro quadro (sem JS, ou já vista na sessão, a tela nem aparece).
// Enquanto ela está na tela, a entrada da hero fica pausada e o resto da página fica inerte (teclado e leitor de tela).
// Se este script não rodar, o <head> do BaseLayout libera a página sozinho em 8 s.
import { marca } from '../../data/site';
import { scallop } from '../ui/mark';

const graus = Array.from({ length: 181 }, (_, i) => String(i).padStart(3, '0'));
---

<!-- role="status": o leitor de tela ouve a nota mudar para "no ponto · pode servir"; o resto é decoração -->
<div class="forno" role="status">
  <div class="lw">
    <svg class="mark" viewBox="0 0 80 80" aria-hidden="true">
      <path class="sc" pathLength="1" d={scallop} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
      <g class="jj">
        <circle cx="40" cy="40" r="23" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2.5 3.2" opacity=".7" />
        <text x="40.5" y="51" text-anchor="middle" style="font-family: var(--serif)" font-style="italic" font-size="31" fill="currentColor">J</text>
      </g>
    </svg>
    <div class="wordmark" aria-hidden="true">{marca.nomeCurto}</div>
    <div class="lsub" aria-hidden="true">confeitaria artesanal</div>
    <div class="odo" aria-hidden="true"><span class="br">[</span><span class="win"><span class="reel">{graus.map((g) => <div>{g}</div>)}</span></span><span class="br">/ 180 <em>°C</em> ]</span></div>
    <div class="lbar" aria-hidden="true"><i></i></div>
    <div class="lnote">preaquecendo o forno</div>
  </div>
</div>

<style>
  .forno { display: none; position: fixed; inset: 0; z-index: 200; place-items: center; background: var(--bg); transition: opacity .45s ease, visibility .45s; }
  :global(html.carregando) .forno, .forno.saindo { display: grid; }
  .forno.saindo { opacity: 0; visibility: hidden; pointer-events: none; }
  :global(html.carregando) { overflow: hidden; }
  /* a entrada da hero (CSS por tempo) espera a tela sumir */
  :global(html.carregando .hero), :global(html.carregando .hero *) { animation-play-state: paused !important; }

  .lw { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .mark { width: 82px; height: 82px; color: var(--accent); margin-bottom: 1.3rem; }
  /* desenho no ritmo da tela curta (mínimo de 900 ms): a forminha e o nome fecham antes de ela sumir */
  .sc { stroke-dasharray: 1; stroke-dashoffset: 1; animation: forno-desenha .8s var(--e-out) .05s forwards; }
  .jj { opacity: 0; animation: forno-aparece .5s ease .35s forwards; }
  .wordmark { padding-left: .42em; }
  .lsub { margin-top: .55rem; font-size: .56rem; letter-spacing: .5em; text-transform: uppercase; color: var(--accent-ink); padding-left: .5em; }
  .odo { display: flex; align-items: center; gap: .35em; margin-top: 2.1rem; font-family: var(--serif); font-weight: 300; font-size: 2.3rem; line-height: 1; color: var(--ink); }
  .br { color: var(--muted); }
  /* cada grau ocupa 1.3em: com linha de 1em os algarismos da Newsreader passam da caixa e o número seguinte aparecia
     cortado na borda de baixo da janela. O script anda de 1.3em em 1.3em (PASSO). */
  .win { position: relative; width: 1.75em; height: 1.3em; overflow: hidden; }
  .reel { position: absolute; left: 0; top: 0; width: 100%; text-align: center; will-change: transform; }
  .reel div { height: 1.3em; line-height: 1.3; }
  .odo em { font-style: italic; color: var(--accent); }
  .lbar { position: relative; width: 180px; height: 1px; margin-top: 1.4rem; overflow: hidden; background: linear-gradient(90deg, transparent, var(--accent), transparent); }
  .lbar i { position: absolute; inset: 0; width: 45%; background: linear-gradient(90deg, transparent, var(--ink), transparent); animation: forno-brilho 1.5s infinite; }
  .lnote { margin-top: 1rem; font-size: .58rem; letter-spacing: .34em; text-transform: uppercase; color: var(--muted); }
  @keyframes forno-brilho { from { transform: translateX(-100%); } to { transform: translateX(260%); } }
  @keyframes forno-desenha { to { stroke-dashoffset: 0; } }
  @keyframes forno-aparece { to { opacity: 1; } }

  /* movimento reduzido: forminha já desenhada, sem brilho correndo; o odômetro só conta rápido */
  @media (prefers-reduced-motion: reduce) {
    .sc { animation: none; stroke-dashoffset: 0; }
    .jj { animation: none; opacity: 1; }
    .lbar i { animation: none; opacity: 0; }
    .forno { transition-duration: .3s; }
  }
</style>

<script>
  const raiz = document.documentElement;
  const forno = document.querySelector<HTMLElement>('.forno');
  if (forno && raiz.classList.contains('carregando')) {
    // enquanto a tela cobre a página, o resto fica inerte: o Tab e o leitor de tela não entram no que está por baixo
    const resto = [...document.body.children].filter((e) => e !== forno);
    resto.forEach((e) => e.setAttribute('inert', ''));
    const reel = forno.querySelector<HTMLElement>('.reel')!;
    const nota = forno.querySelector<HTMLElement>('.lnote')!;
    const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const MIN = reduzido ? 300 : 900; // tempo mínimo para a subida não ser um piscar
    const PASSO = 1.3; // altura de cada grau no odômetro, em em (igual ao CSS de .reel div)
    const t0 = performance.now();

    // progresso real: fontes (40%) e o pôster da hero (60%); depois de 5,5 s termina de qualquer jeito
    let fontes = false, poster = false, forcado = false;
    (document.fonts?.ready ?? Promise.resolve()).then(() => { fontes = true; });
    const src = document.querySelector<HTMLVideoElement>('.hero video')?.poster;
    if (src) { const img = new Image(); img.onload = img.onerror = () => { poster = true; }; img.src = src; } else poster = true;
    setTimeout(() => { forcado = true; }, 5500);

    let atual = 0, saiu = false;
    const sair = () => {
      if (saiu) return;
      saiu = true;
      reel.style.transform = `translateY(-${180 * PASSO}em)`;
      nota.textContent = 'no ponto · pode servir';
      setTimeout(() => {
        try { sessionStorage.setItem('jhessica:forno', '1'); } catch {}
        forno.classList.add('saindo'); // mantém a tela visível só para o fade
        raiz.classList.remove('carregando'); // a hero começa a entrar
        resto.forEach((e) => e.removeAttribute('inert'));
        forno.addEventListener('transitionend', () => forno.remove(), { once: true });
        setTimeout(() => forno.remove(), 800); // plano B: sem transitionend (transição desligada), a tela sai do mesmo jeito
      }, 200);
    };
    const passo = (t: number) => {
      if (saiu) return;
      const prog = forcado ? 1 : (fontes ? .4 : 0) + (poster ? .6 : 0);
      const alvo = 180 * Math.min(prog, Math.min(1, (t - t0) / MIN));
      atual += (alvo - atual) * .16;
      if (alvo === 180 && 180 - atual < .8) atual = 180;
      reel.style.transform = `translateY(-${Math.round(atual) * PASSO}em)`;
      if (atual < 180) { requestAnimationFrame(passo); return; }
      sair();
    };
    requestAnimationFrame(passo);
    // o odômetro anda por quadro: com quadros lentos (aparelho econômico, aba em segundo plano) ele demoraria.
    // Passado o prazo, a tela sai por tempo, sem esperar a animação (a trava de 8 s do BaseLayout fica de reserva)
    setTimeout(sair, 6500);
  }
</script>
