---
// Rodapé em faixa cacau (Asagiri footer): marca, colunas de links, social e linha legal.
// Links saem de `menu` e `redes` (src/data/site.ts). Rede sem endereço aparece desabilitada, nunca aponta para "#".
import { marca, menu, pedido, redes } from '../../data/site';
import Logo from '../ui/Logo.astro';
import { url } from '../../lib/url';
import Icon from '../ui/Icon.astro';

const ano = new Date().getFullYear();
const social = [
  { label: 'Instagram da Jhessica', icon: 'simple-icons:instagram', href: redes.instagram },
  { label: 'WhatsApp da Jhessica', icon: 'simple-icons:whatsapp', href: redes.whatsapp },
] as const;
---

<footer class="foot band">
  <div class="wrapx">
    <div class="frow">
      <div class="fbrand">
        <Logo href={url('/#top')} text={false} />
        <p class="wordmark">{marca.nomeCurto}</p>
        <p class="hand">{marca.assinatura.toLowerCase()}</p>
      </div>
      <div class="fcols">
        <div class="fcol">
          <h2>Navegue</h2>
          {menu.map((l) => <a href={l.href}>{l.rotulo}</a>)}
          <a href={url('/#perguntas')}>Perguntas frequentes</a>
        </div>
        <div class="fcol">
          <h2>Ateliê</h2>
          <a href={pedido.href}>{pedido.rotulo}</a>
          <span>Retirada com hora marcada</span>
          <div class="social">
            {social.map((s) => s.href ? (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener"><Icon name={s.icon} /></a>
            ) : (
              <a role="link" aria-disabled="true" aria-label={`${s.label} (em breve)`} class="is-off"><Icon name={s.icon} /></a>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="fbot">
      <span>© {ano} {marca.nome}</span>
      <span>Feito à mão, como os bolos. · Site por <a href="https://www.linkedin.com/in/jhonatanalmeida" target="_blank" rel="noopener">Jhonatan Almeida</a></span>
    </div>
  </div>
</footer>

<style>
  .foot { padding: clamp(4rem, 9vh, 7rem) 0 2.5rem; }
  .frow { display: flex; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; align-items: flex-start; }
  .fbrand :global(.mark) { width: 56px; height: 56px; color: var(--accent-2); margin-bottom: 1rem; }
  .fbrand .wordmark { font-size: 1.6rem; }
  .fbrand .hand { margin-top: .8rem; color: #EFC98C; font-size: 1.35rem; }
  .fcols { display: flex; flex-wrap: wrap; gap: 4rem; }
  .fcol h2 { margin-bottom: 1rem; font-size: .6rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--accent-2); }
  .fcol > a, .fcol > span { display: block; margin-bottom: .55rem; font-size: .88rem; color: var(--on-band-2); transition: color .3s; }
  .fcol > a:hover { color: var(--on-band); }
  .social { display: flex; gap: .7rem; margin-top: 1rem; }
  .social a { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-size: 15px; color: var(--on-band-2); border: 1px solid var(--band-line); transition: color .3s, border-color .3s, transform .4s var(--e-out); }
  .social a[href]:hover { color: var(--accent-2); border-color: var(--accent-2); transform: translateY(-2px); }
  .social .is-off { opacity: .4; cursor: not-allowed; }
  .fbot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 3.5rem; padding-top: 1.6rem; border-top: 1px solid var(--band-line); font-size: .68rem; letter-spacing: .04em; color: var(--on-band-2); }
  .fbot a { color: var(--on-band); text-decoration: underline; text-decoration-color: var(--band-line); text-underline-offset: 3px; transition: text-decoration-color .3s; }
  .fbot a:hover { text-decoration-color: var(--accent-2); }
</style>
