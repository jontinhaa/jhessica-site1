---
// /pedido · cardápio completo (etapa 11a): topo compacto, barra de categorias fixa, uma seção por categoria com os cards
// e um painel "Detalhes" por produto; a sacola (folha com os 3 passos até o WhatsApp) em components/pedido/Sacola.astro.
// As âncoras #bolos, #paes, #brigadeiros e #bento são os ids das seções (a vitrine da home aponta para elas); #fatias volta
// quando a categoria deixar de ser oculta em cardapio.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import ProdutoCard from '../components/pedido/ProdutoCard.astro';
import ProdutoPainel from '../components/pedido/ProdutoPainel.astro';
import Sacola from '../components/pedido/Sacola.astro';
import { marca, regrasPedido } from '../data/site';
import { categorias, getProdutosPorCategoria, produtos } from '../data/cardapio';
---

<BaseLayout title={`Cardápio completo · ${marca.nome}`}>
  <section class="sec topo" data-aba={categorias[0].id}>
    <div class="wrapx">
      <SectionHeading rotulo="Cardápio" titulo="Monte seu" tituloDestaque="pedido." as="h1" />
      <p class="lead">Receitas sem glúten e sem leite. Escolha, monte e mande pelo WhatsApp.</p>
      <p class="t-s prazos">Pedidos com {regrasPedido.prazoMinimoDias} dias de antecedência · Bento Cake e bolos de aniversário com {regrasPedido.prazoEspecialDias} dias</p>
    </div>
  </section>

  <nav class="abas" aria-label="Categorias do cardápio">
    <div class="abas-trilho">
      {categorias.map((c, i) => <a class:list={['tab', i === 0 && 'is-on']} href={`#${c.id}`} aria-current={i === 0 ? 'true' : undefined}>{c.nome}</a>)}
    </div>
  </nav>

  {categorias.map((cat) => (
    <section class="categoria" id={cat.id} aria-labelledby={`t-${cat.id}`}>
      <div class="wrapx">
        <header class="cat-head">
          <h2 class="h3" id={`t-${cat.id}`}>{cat.nome}</h2>
          <p class="t-m">{cat.chamada}</p>
        </header>
        <ul class="produtos">
          {getProdutosPorCategoria(cat.id).map((p) => <li><ProdutoCard produto={p} /></li>)}
        </ul>
      </div>
    </section>
  ))}

  {produtos.map((p) => <ProdutoPainel produto={p} />)}

  <Sacola />

  <div class="toast" id="toast" role="status" aria-live="polite"><Icon name="solar:check-circle-bold" /><span data-toast-texto></span><button type="button" data-toast-acao hidden></button></div>
</BaseLayout>

<style>
  .topo { padding-top: calc(var(--nav-h) + clamp(2rem, 5vw, 3.5rem)); padding-bottom: clamp(1.5rem, 4vw, 2.5rem); }
  .topo :global(.head) { margin-bottom: 1.4rem; }
  .prazos { margin-top: .8rem; }

  /* barra de categorias: gruda logo abaixo do header e rola de lado */
  .abas { position: sticky; top: var(--nav-h); z-index: 40; background: rgba(var(--bg-rgb), .82); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); border-block: 1px solid var(--line); }
  .abas-trilho { display: flex; gap: .5rem; max-width: var(--max); margin-inline: auto; padding: .7rem var(--pad); overflow-x: auto; scrollbar-width: none; }
  .tab { flex: none; display: inline-grid; place-items: center; height: 40px; padding: 0 1.2rem; border-radius: var(--r-pill); border: 1px solid var(--line-2); font-size: .625rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-2); transition: all .3s var(--e-std); }
  .tab:hover { border-color: var(--accent); color: var(--accent-ink); }
  .tab.is-on { background: rgba(var(--accent-rgb), .14); border-color: var(--accent); color: var(--accent-ink); }
  .tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .categoria { padding: clamp(2.5rem, 6vw, 4.5rem) 0; scroll-margin-top: calc(var(--nav-h) + 58px); }
  .categoria + .categoria { border-top: 1px solid var(--line); }
  .cat-head { display: flex; flex-direction: column; gap: .5rem; margin-bottom: clamp(1.5rem, 3vw, 2.2rem); }
  .produtos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  @media (max-width: 1023px) { .produtos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; } }
  @media (max-width: 359px) { .produtos { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  // aba ativa acompanha a categoria à vista; a barra rola para mostrar a aba
  const abas = [...document.querySelectorAll<HTMLAnchorElement>('.abas .tab')];
  const trilho = document.querySelector<HTMLElement>('.abas-trilho')!;
  const ativar = (id: string) => abas.forEach((a) => {
    const on = a.hash === `#${id}`;
    a.classList.toggle('is-on', on);
    a.toggleAttribute('aria-current', on);
    if (on) trilho.scrollTo({ left: a.offsetLeft - trilho.offsetLeft - 16, behavior: 'smooth' });
  });
  // o topo da página conta como a primeira categoria (voltando ao topo, a aba volta para ela)
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (e.isIntersecting) ativar((e.target as HTMLElement).dataset.aba ?? e.target.id);
  }), { rootMargin: '-30% 0px -60% 0px' });
  document.querySelectorAll('.topo, .categoria').forEach((s) => io.observe(s));
</script>
