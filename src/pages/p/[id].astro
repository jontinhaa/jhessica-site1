---
// /p/{id} · uma página por produto, só para o link compartilhado mostrar prévia (título, descrição e foto em og:*).
// Quem abre é levado ao painel do produto no /pedido; o robô do WhatsApp lê o HTML antes do redirecionamento.
// Foto 1200×630 em jpeg (o WhatsApp ignora imagem pesada): a capa do produto; sem ela, a imagem padrão do site (poster da hero).
// TODO: fotos reais por produto.
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ogPadrao from '../../assets/images/og-padrao.jpg';
import { getImagensProduto, produtos, type Produto } from '../../data/cardapio';
import { marca } from '../../data/site';
import { url } from '../../lib/url';
import { urlAbsoluta } from '../../lib/absoluta';
import { textoCompartilhar } from '../../lib/pedido/compartilhar';

export function getStaticPaths() {
  return produtos.filter((p) => p.disponivel).map((produto) => ({ params: { id: produto.id }, props: { produto } }));
}

interface Props { produto: Produto }
const { produto: p } = Astro.props;

const foto = getImagensProduto(p.id).capa ?? ogPadrao;
const og = await getImage({ src: foto, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });

const destino = url(`/pedido?produto=${p.id}`);
---
<BaseLayout
  title={`${p.nome} · ${marca.nome}`}
  description={textoCompartilhar(p).texto}
  image={urlAbsoluta(og.src, Astro.site)}
  imageLargura={1200}
  imageAltura={630}
  imageAlt={`${p.nome}, ${marca.nome}`}
  canonical={urlAbsoluta(destino, Astro.site)}
  redirect={destino}
  noindex
>
  <section class="sec">
    <div class="wrapx">
      <h1 class="h3">{p.nome}</h1>
      <p class="lead">{p.descricao}</p>
      <p>Abrindo o cardápio… Se não abrir, toque em <a class="link-r" href={destino}>Ver produto</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .sec { padding-top: calc(var(--nav-h) + clamp(2rem, 5vw, 3.5rem)); padding-bottom: clamp(2rem, 5vw, 3.5rem); }
</style>
